{
  "name": "nobeoka-ugokasu",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-build-info.mjs && node scripts/sync-social-posts.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/generate-build-info.mjs && node scripts/sync-social-posts.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:functions": "tsc --noEmit -p functions/tsconfig.json",
    "dev:pages": "npm run build && wrangler pages dev dist --kv SOCIAL_POSTS_KV --compatibility-date=2026-07-01",
    "seo:check": "node scripts/seo-check.mjs",
    "test:social": "esbuild scripts/tests/social-sync.test.ts --bundle --platform=node --format=esm --external:sharp --outfile=.astro/test/social-sync.test.mjs --log-level=warning && node .astro/test/social-sync.test.mjs",
    "test:staff-auth": "esbuild scripts/tests/staff-auth.test.ts --bundle --platform=node --format=esm --outfile=.astro/test/staff-auth.test.mjs --log-level=warning && node --no-warnings .astro/test/staff-auth.test.mjs",
    "test:dialogue": "esbuild scripts/tests/dialogue.test.ts --bundle --platform=node --format=esm --outfile=.astro/test/dialogue.test.mjs --log-level=warning && node --no-warnings .astro/test/dialogue.test.mjs",
    "test:welfare-dialogue": "esbuild scripts/tests/welfare-dialogue.test.ts --bundle --platform=node --format=esm --outfile=.astro/test/welfare-dialogue.test.mjs --log-level=warning && node --no-warnings .astro/test/welfare-dialogue.test.mjs",
    "d1:migrate": "wrangler d1 execute nobeoka-staff --remote --file migrations/0002_dialogue_events.sql && wrangler d1 execute nobeoka-staff --remote --file migrations/0003_news_items.sql && wrangler d1 execute nobeoka-staff --remote --file migrations/0004_events.sql && wrangler d1 execute nobeoka-staff --remote --file migrations/0005_tasks.sql && wrangler d1 execute nobeoka-staff --remote --file migrations/0006_staff_rate_limits.sql && wrangler d1 execute nobeoka-staff --remote --file migrations/0007_staff_documents.sql",
    "test:news": "esbuild scripts/tests/news.test.ts --bundle --platform=node --format=esm --outfile=.astro/test/news.test.mjs --log-level=warning && node --no-warnings .astro/test/news.test.mjs",
    "test:events": "esbuild scripts/tests/events.test.ts --bundle --platform=node --format=esm --outfile=.astro/test/events.test.mjs --log-level=warning && node --no-warnings .astro/test/events.test.mjs",
    "test:tasks": "esbuild scripts/tests/tasks.test.ts --bundle --platform=node --format=esm --outfile=.astro/test/tasks.test.mjs --log-level=warning && node --no-warnings .astro/test/tasks.test.mjs",
    "test:sns-admin": "esbuild scripts/tests/sns-admin.test.ts --bundle --platform=node --format=esm --outfile=.astro/test/sns-admin.test.mjs --log-level=warning && node --no-warnings .astro/test/sns-admin.test.mjs",
    "test:documents": "esbuild scripts/tests/documents.test.ts --bundle --platform=node --format=esm --outfile=.astro/test/documents.test.mjs --log-level=warning && node --no-warnings .astro/test/documents.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.4",
    "astro": "^5.1.1",
    "jose": "6.2.12",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260716.1",
    "sharp": "^0.34.0",
    "wrangler": "^4.0.0"
  }
}
