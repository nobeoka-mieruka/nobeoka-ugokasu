---
// サイト全体の最終更新日（GitHub mainブランチへ反映された最新コミットの日時）を表示する。
// scripts/generate-build-info.mjs がビルド前に生成する src/data/build-info.json を読み込む。
//
// ・アクセス時刻ではなく、実際に内容が更新された日を表示する（4章）。
// ・書式はサイト内の他の「最終更新」表示（src/components/LastUpdated.astro）と揃え、
//   「2026年9月7日」の形（時刻なし）にする。
// ・日付が取得できない場合は、何も表示しない（TODO・undefined・Invalid Dateは表示しない）。
import { getSiteLastUpdated, formatLastUpdated } from "../utils/lastUpdated";

const lastUpdated = getSiteLastUpdated();
const label = lastUpdated ? formatLastUpdated(lastUpdated) : null;
---

{lastUpdated && label && (
  <p class="text-xs text-white/60">
    最終更新：<time datetime={lastUpdated.toISOString()}>{label}</time>
  </p>
)}
