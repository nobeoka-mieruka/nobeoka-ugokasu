---
// 「本人へのお問い合わせ」と「後援会事務局へのお問い合わせ」を、
// 用途が混同されないよう見出し・説明文つきで並べて表示するコンポーネントです。
// アドレス・表示名・説明文は src/config/siteConfig.ts の contact で一元管理しています。
import MailLink from "./MailLink.astro";
import { siteConfig } from "../config/siteConfig";

interface Props {
  /** 見出しの配置（トップページの中央寄せカードでは "center"） */
  align?: "left" | "center";
}

const { align = "left" } = Astro.props;

const entries = [
  { to: "personal" as const, ...siteConfig.contact.personal },
  { to: "office" as const, ...siteConfig.contact.office },
];
---

<div class:list={["grid gap-4 sm:grid-cols-2", align === "center" ? "text-center" : "text-left"]}>
  {entries.map((entry) => (
    <div class="min-w-0 rounded-xl border border-ink/10 bg-white p-4">
      <h3 class="font-bold text-ink">【{entry.fullLabel.replace(`${siteConfig.organizationName} `, "")}】</h3>
      <p class="mt-1 text-sm text-ink-soft leading-relaxed">{entry.description}</p>
      <div class:list={["mt-2", align === "center" && "flex justify-center"]}>
        <MailLink to={entry.to} showLabel={false} />
      </div>
    </div>
  ))}
</div>
