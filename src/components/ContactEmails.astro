---
// 「本人へのお問い合わせ」と「後援会事務局へのお問い合わせ」を、
// 用途が混同されないよう見出し・説明文つきで並べて表示するコンポーネントです。
// アドレス・表示名・説明文は src/config/siteConfig.ts の contact で一元管理しています。
// 問い合わせ先を掲載する箇所では、原則としてこのコンポーネントで2つの窓口をセットで表示します。
import MailLink from "./MailLink.astro";
import { siteConfig } from "../config/siteConfig";

interface Props {
  /** 見出しの配置（トップページの中央寄せカードでは "center"） */
  align?: "left" | "center";
  /**
   * 表示の種類
   * ・card    … 白背景の本文中（既定）
   * ・compact … 団体概要・規約ページなど本文中の小さめ表示
   * ・footer  … 濃い背景のフッター用（文字を小さくし、縦に長くなりすぎないようにする）
   */
  variant?: "card" | "compact" | "footer";
}

const { align = "left", variant = "card" } = Astro.props;

// 見出しは「福富千恵本人」「後援会事務局」と「へのお問い合わせ」の2つのまとまりに分け、
// 狭い画面でも「本人へ／のお問い合わせ」のような不自然な位置で改行されないようにする
const suffix = "へのお問い合わせ";
const toHeading = (fullLabel: string) => {
  const label = fullLabel.replace(`${siteConfig.organizationName} `, "");
  return { lead: label.slice(0, -suffix.length), suffix };
};

const entries = [
  { to: "personal" as const, ...siteConfig.contact.personal, heading: toHeading(siteConfig.contact.personal.fullLabel) },
  { to: "office" as const, ...siteConfig.contact.office, heading: toHeading(siteConfig.contact.office.fullLabel) },
];

const styles = {
  card: {
    box: "rounded-xl border border-ink/10 bg-white px-3 py-4 sm:p-4",
    heading: "font-bold text-ink",
    description: "mt-1 text-sm text-ink-soft leading-relaxed",
    link: "font-bold text-ink underline",
    icon: "text-brand-orange",
  },
  compact: {
    box: "rounded-lg border border-ink/10 bg-white px-3 py-3",
    heading: "text-sm font-bold text-ink",
    description: "mt-1 text-xs text-ink-soft leading-relaxed",
    link: "text-sm font-bold text-ink underline",
    icon: "text-brand-orange",
  },
  footer: {
    box: "rounded-lg border border-white/15 px-3 py-2",
    heading: "text-sm font-bold text-white",
    description: "mt-0.5 text-xs text-white/70 leading-relaxed",
    link: "text-sm text-white/85 underline hover:text-brand-orange",
    icon: "text-brand-orange",
  },
}[variant];
---

<div class:list={["grid gap-3 sm:grid-cols-2", variant === "card" && "sm:gap-4", align === "center" ? "text-center" : "text-left"]}>
  {entries.map((entry) => (
    <div class:list={["min-w-0", styles.box]}>
      <h3 class:list={[styles.heading]}>
        <span class="inline-block">【{entry.heading.lead}</span><span class="inline-block">{entry.heading.suffix}】</span>
      </h3>
      <p class:list={[styles.description]}>{entry.description}</p>
      <div class:list={[variant === "footer" ? "" : "mt-2", align === "center" && "flex justify-center"]}>
        <MailLink to={entry.to} showLabel={false} class={styles.link} iconClass={styles.icon} />
      </div>
    </div>
  ))}
</div>
