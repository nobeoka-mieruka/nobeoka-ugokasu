---
// 全画面のモバイルメニューパネル本体。
// ヘッダー（backdrop-blur指定あり）の外側の兄弟要素として配置する必要があるため、
// Header.astro内の<header>要素の外に置いてください（MobileMenu.astro側のコメント参照）。
import type { NavItem } from "../data/navigation";
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";

interface Props {
  items: NavItem[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;

function isCurrent(href: string, path: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<div
  id="mobile-menu-panel"
  class="fixed inset-0 z-50 overflow-y-auto bg-white lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-menu-title"
  hidden
>
  <div class="flex items-center justify-between px-4 py-4 border-b border-black/10">
    <span id="mobile-menu-title" class="font-bold text-ink">メニュー</span>
    <button
      id="mobile-menu-close"
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-ink hover:bg-brand-orange-light"
    >
      <span class="sr-only">メニューを閉じる</span>
      <Icon name="close" class="w-7 h-7" />
    </button>
  </div>
  <nav aria-label="モバイルメニュー" class="px-4 py-6">
    <ul class="space-y-1">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "block rounded-lg px-4 py-3 text-lg font-bold border-l-4",
              isCurrent(item.href, currentPath)
                ? "bg-brand-orange-light text-ink border-brand-orange-dark"
                : "text-ink border-transparent hover:bg-brand-orange-light",
            ]}
            aria-current={isCurrent(item.href, currentPath) ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="px-4 pt-2 pb-6 border-t border-black/10 mt-2">
    <SocialLinks />
  </div>
</div>

<script>
  // 開いている間は、メニューの外（ヘッダー・本文・フッター）を inert にして、キーボードやスクリーンリーダーで
  // 背後の内容へ移動しないようにする（WCAG 2.4.3・2.4.11）。Tab はメニューの中で循環し、Esc でどこからでも閉じる。
  const button = document.getElementById("mobile-menu-button");
  const closeButton = document.getElementById("mobile-menu-close");
  const panel = document.getElementById("mobile-menu-panel");
  const desktop = window.matchMedia("(min-width: 1024px)");
  let inerted: HTMLElement[] = [];

  const focusables = () =>
    panel
      ? Array.from(panel.querySelectorAll<HTMLElement>("a[href], button:not([disabled]), [tabindex]:not([tabindex=\"-1\"])")).filter(
          (el) => el.offsetParent !== null || el === document.activeElement,
        )
      : [];

  function setBackgroundInert(on: boolean) {
    if (on) {
      inerted = Array.from(document.body.children).filter(
        (el): el is HTMLElement => el instanceof HTMLElement && el !== panel && !el.inert && el.tagName !== "SCRIPT",
      );
      inerted.forEach((el) => (el.inert = true));
    } else {
      inerted.forEach((el) => (el.inert = false));
      inerted = [];
    }
  }

  function onKeydown(e: KeyboardEvent) {
    if (!panel || panel.hidden) return;
    if (e.key === "Escape") {
      e.preventDefault();
      closeMenu();
      return;
    }
    if (e.key !== "Tab") return;
    const items = focusables();
    if (items.length === 0) return;
    const first = items[0];
    const last = items[items.length - 1];
    const active = document.activeElement;
    if (e.shiftKey && (active === first || !panel.contains(active))) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && (active === last || !panel.contains(active))) {
      e.preventDefault();
      first.focus();
    }
  }

  function openMenu() {
    if (!panel || !button) return;
    panel.hidden = false;
    button.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    setBackgroundInert(true);
    document.addEventListener("keydown", onKeydown);
    closeButton?.focus();
  }

  function closeMenu({ restoreFocus = true } = {}) {
    if (!panel || !button || panel.hidden) return;
    panel.hidden = true;
    button.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    setBackgroundInert(false);
    document.removeEventListener("keydown", onKeydown);
    if (restoreFocus) button.focus();
  }

  button?.addEventListener("click", openMenu);
  closeButton?.addEventListener("click", () => closeMenu());
  // ページ内リンク（#…）を選んだときもメニューを閉じる（移動先へフォーカスを渡すため、ボタンへは戻さない）
  panel?.addEventListener("click", (e) => {
    if (e.target instanceof Element && e.target.closest("a[href]")) closeMenu({ restoreFocus: false });
  });
  // 画面を回転・拡大してパソコン用の表示（1024px以上）になったら閉じる（背後が操作できないままにならないように）
  desktop.addEventListener("change", (e) => {
    if (e.matches) closeMenu({ restoreFocus: false });
  });
</script>
