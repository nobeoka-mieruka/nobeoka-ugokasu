---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/HeroSection.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ActivityCard from "../../components/ActivityCard.astro";
import ActivityEntryCard from "../../components/ActivityEntryCard.astro";
import SnsActivityCard from "../../components/SnsActivityCard.astro";
import SocialPostCard from "../../components/SocialPostCard.astro";
import ActivityFilterBar from "../../components/ActivityFilterBar.astro";
import ActivityFallbackNotice from "../../components/ActivityFallbackNotice.astro";
import LastUpdated from "../../components/LastUpdated.astro";
import Icon from "../../components/Icon.astro";
import { webPageSchema } from "../../utils/structuredData";
import { buildBreadcrumbList } from "../../utils/seo";
import { resolveLastUpdated } from "../../utils/lastUpdated";
import { getUnifiedActivities } from "../../data/activities";
import { getActivityEntriesLastUpdated } from "../../data/activityEntries";
import { socialLinks } from "../../data/socialLinks";
import { socialConfig } from "../../config/socialConfig";
import { socialPlatformMeta, type SocialPlatformKey } from "../../config/socialPlatformMeta";

const title = "活動報告｜福富千恵と延岡を動かす会";
const description = "福富千恵と延岡を動かす会が延岡市内で行った活動の報告一覧です。実施の目的や参加者の声、今後の対応をお伝えします。";
const breadcrumbItems = [{ name: "活動報告", path: "/activities" }];

// トップページと共通のデータ取得口（src/data/activities.ts）を使い、常に同じ並び順・
// 同じ絞り込み結果になるようにする。
// SNSのAPI取得に失敗しても、ここでSSRされた分（サイト側に保存済みの活動データ）は
// 必ず表示されるため、ページが空になることはない（15章の段階的フォールバック）。
const unifiedActivities = await getUnifiedActivities();

// ページ読み込み後にAPI（/api/social-feed）からも最新の投稿を取得し、ここでSSRされた分に
// 無い投稿（ビルド後に新規投稿された分）だけを差し込む。
const hasAnyActivity = unifiedActivities.length > 0;

// SNS別の空状態は、そのSNSのリンクが設定されている場合のみ用意する
const platformEmptyStates = (["facebook", "instagram", "threads"] as SocialPlatformKey[])
  .filter((key) => Boolean(socialLinks[key]))
  .map((key) => ({
    key,
    meta: socialPlatformMeta[key],
    url: socialLinks[key],
  }));

// 最終更新日：活動データそのものの更新日を優先し、無い場合はサイトの更新日（gitコミット日時）
const latestActivityDate = unifiedActivities[0]?.date.toISOString() ?? null;
const lastUpdated = resolveLastUpdated(getActivityEntriesLastUpdated() ?? latestActivityDate, "activities");

const schemas = [
  webPageSchema({ path: "/activities", name: title, description }),
  buildBreadcrumbList(breadcrumbItems),
];
---

<BaseLayout title={title} description={description} path="/activities" schemas={schemas}>
  <Breadcrumb items={breadcrumbItems} />
  <HeroSection title="活動報告" description="福富千恵と延岡を動かす会の地域活動をお伝えします。Facebook・Instagram・Threadsの投稿もあわせてご覧いただけます。" />

  <section class="pt-10 sm:pt-14">
    <div class="section-wrap">
      <a href="/photos/" class="card flex items-center gap-4 hover:shadow-md transition-shadow">
        <span class="flex items-center justify-center w-12 h-12 rounded-full bg-brand-orange-light text-brand-orange-dark flex-shrink-0">
          <Icon name="document" class="w-6 h-6" />
        </span>
        <span class="min-w-0">
          <span class="block font-bold text-ink">活動写真を見る</span>
          <span class="block text-sm text-ink-soft">現場での活動の様子を写真でご紹介しています。</span>
        </span>
      </a>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="section-wrap">
      <h2 class="sr-only">活動報告一覧</h2>
      <ActivityFilterBar />

      <div
        id="activity-grid"
        role="tabpanel"
        aria-labelledby="activity-tab-all"
        aria-live="polite"
        class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 items-start"
        data-activity-grid
        data-instagram-username={socialConfig.instagramUsername}
      >
        {unifiedActivities.map((item) => {
          if (item.kind === "website") {
            return (
              <div data-activity-card data-platforms="website" data-date={item.date.toISOString()}>
                <ActivityCard
                  slug={item.entry.slug}
                  title={item.entry.data.title}
                  date={item.entry.data.date}
                  category={item.entry.data.category}
                  summary={item.entry.data.summary}
                  mainImage={item.entry.data.mainImage}
                />
              </div>
            );
          }
          if (item.kind === "manual") {
            return <ActivityEntryCard entry={item.entry} />;
          }
          if (item.kind === "social") {
            return <SocialPostCard post={item.entry} instagramUsername={socialConfig.instagramUsername} />;
          }
          return <SnsActivityCard entry={item.entry} />;
        })}
      </div>

      <div class="mt-8 flex justify-center">
        <button
          type="button"
          data-activity-load-more
          class="hidden btn-secondary"
        >
          もっと見る
        </button>
      </div>

      {/*
        絞り込みタブごとの空状態。
        ・同じ「SNSでも活動を発信しています」という案内が何枚も同時に表示されないよう、
          SNSへの導線を含む案内は「すべて」タブ用の1枚だけに集約している。
        ・絞り込みタブは同時に1つしか選べないため、下の各要素は常に最大1枚だけ表示される。
        ・JavaScript実行前にすべての空状態が一瞬まとめて表示されてしまうことを防ぐため、
          「すべて」タブ以外は初期状態で hidden にしている（src/components/ActivityFilterBar.astro
          の applyFilter が、現在の絞り込みに応じて表示を切り替える）。
      */}
      <div class="mt-6">
        <ActivityFallbackNotice emptyFor="all" initiallyHidden={hasAnyActivity} />

        <div data-empty-for="website" class="hidden">
          <div class="card text-center py-10 text-ink-soft flex flex-col items-center gap-3">
            <Icon name="document" class="w-8 h-8 text-brand-orange" />
            <p>公式サイトに掲載した活動報告は、順次こちらへ追加していきます。</p>
          </div>
        </div>

        {platformEmptyStates.map((platform) => (
          <div data-empty-for={platform.key} class="hidden">
            <div class="card text-center py-10 flex flex-col items-center gap-4">
              <Icon name={platform.meta.icon} class="w-8 h-8 text-brand-orange" />
              <p class="text-ink-soft leading-relaxed">
                {platform.meta.label}の最新の投稿は、{platform.meta.label}のページからご覧いただけます。
              </p>
              <a
                href={platform.url}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "inline-flex min-h-[44px] items-center gap-2 rounded-full px-5 py-2.5 text-base font-bold transition-all",
                  platform.meta.buttonClass,
                ]}
              >
                <Icon name={platform.meta.icon} class="w-5 h-5" />
                {platform.meta.label}を見る
                <Icon name="external-link" class="w-3.5 h-3.5" ariaHidden={true} />
                <span class="sr-only">（新しいタブで開く）</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-10">
        <LastUpdated date={lastUpdated} />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchSocialPosts } from "../../services/socialPosts";
  import { createSocialPostCardElement } from "../../scripts/socialPostCard";
  import { registerActivityImageFallback } from "../../scripts/activityImageFallback";
  import { getExistingActivityLinks, insertActivityCardSorted } from "../../scripts/activityGrid";

  const grid = document.querySelector<HTMLElement>("[data-activity-grid]");

  // ビルド時に出力された投稿カードの画像読み込み失敗フォールバックを有効化する
  registerActivityImageFallback();

  /** 取得中であることを示す、既存カードと同じ配色のスケルトンカードを作る */
  function createSkeletonCard(): HTMLElement {
    const card = document.createElement("div");
    card.className = "card p-0 overflow-hidden flex flex-col h-full animate-pulse";
    card.dataset.activityCard = "";
    card.dataset.activitySkeleton = "";
    card.dataset.platforms = "facebook instagram threads";

    const media = document.createElement("div");
    media.className = "h-[200px] sm:h-60 bg-brand-orange-light/60";
    card.append(media);

    const body = document.createElement("div");
    body.className = "p-6 flex flex-col gap-3 flex-1";
    const badge = document.createElement("div");
    badge.className = "h-6 w-28 rounded-full bg-brand-orange-light/60";
    const titleLine = document.createElement("div");
    titleLine.className = "h-5 w-full rounded bg-brand-orange-light/60";
    const textLine = document.createElement("div");
    textLine.className = "h-4 w-2/3 rounded bg-brand-orange-light/60";
    body.append(badge, titleLine, textLine);
    card.append(body);

    return card;
  }

  (async () => {
    // 表示のたびにMeta Graph APIへ直接アクセスすることはせず、Cloudflare側で
    // キャッシュ・正規化済みの /api/social-feed から結果を読み込むだけ。
    const skeletons = grid ? [createSkeletonCard(), createSkeletonCard(), createSkeletonCard()] : [];
    skeletons.forEach((s) => grid?.append(s));
    if (skeletons.length > 0) document.dispatchEvent(new CustomEvent("social-posts:updated"));

    const { posts, fetchFailed, requestFailed } = await fetchSocialPosts();

    skeletons.forEach((s) => s.remove());

    const instagramUsername = grid?.dataset.instagramUsername;

    if (grid && posts.length > 0) {
      const known = getExistingActivityLinks(grid);
      for (const post of posts) {
        // 手動登録済みの投稿（src/data/activityEntries.ts・snsActivities.ts）と
        // 同じURLの場合は重複させない
        if (known.has(post.permalink)) continue;
        const card = createSocialPostCardElement(post, instagramUsername);
        card.dataset.date = post.publishedAt;
        insertActivityCardSorted(grid, card, post.publishedAt);
        known.add(post.permalink);
      }
    }

    // SNSの取得に失敗しても、閲覧者へ技術的なエラーメッセージは表示しない。
    // サイト側に保存済みの活動データがそのまま表示され、1件も無い場合だけ
    // 「最新情報はSNSでも発信しています」という案内（ActivityFallbackNotice）が出る。
    // 原因の切り分けができるよう、内容はコンソールにだけ残す。
    if (requestFailed || fetchFailed) {
      console.warn(
        `[activities] SNSの最新投稿を取得できませんでした（requestFailed=${requestFailed} / fetchFailed=${fetchFailed}）。保存済みの活動データを表示しています。`,
      );
    }

    // 投稿が0件・取得失敗の場合でも、既存の絞り込み状態を再評価してもらう
    document.dispatchEvent(new CustomEvent("social-posts:updated"));
  })();
</script>
