---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/HeroSection.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ActivityCard from "../../components/ActivityCard.astro";
import SnsActivityCard from "../../components/SnsActivityCard.astro";
import SocialPostCard from "../../components/SocialPostCard.astro";
import ActivityFilterBar from "../../components/ActivityFilterBar.astro";
import Icon from "../../components/Icon.astro";
import { webPageSchema } from "../../utils/structuredData";
import { buildBreadcrumbList } from "../../utils/seo";
import { getUnifiedActivities, hasWebsiteActivity, hasPlatformActivity } from "../../data/activities";
import { socialLinks } from "../../data/socialLinks";
import { socialConfig } from "../../config/socialConfig";

const title = "活動報告｜福富千恵と延岡を動かす会";
const description = "福富千恵と延岡を動かす会が延岡市内で行った活動の報告一覧です。実施の目的や参加者の声、今後の対応をお伝えします。";
const breadcrumbItems = [{ name: "活動報告", path: "/activities" }];

// トップページと共通のデータ取得口（src/data/activities.ts）を使い、常に同じ並び順・
// 同じ絞り込み結果になるようにする。
const unifiedActivities = await getUnifiedActivities();

// ページ読み込み後にAPI（/api/social-feed）からも最新の投稿を取得し、ここでSSRされた分に
// 無い投稿（ビルド後に新規投稿された分）だけを差し込む。そのため0件表示になっていても
// クライアント側スクリプトが投稿を見つけ次第、自動的に一覧・絞り込みへ反映される。
const hasWebsite = hasWebsiteActivity(unifiedActivities);
const hasFacebook = hasPlatformActivity(unifiedActivities, "facebook");
const hasInstagram = hasPlatformActivity(unifiedActivities, "instagram");
const hasThreads = hasPlatformActivity(unifiedActivities, "threads");
const hasAnyActivity = unifiedActivities.length > 0;

const officialSnsLinks = [
  { key: "facebook" as const, label: "Facebookを見る" },
  { key: "instagram" as const, label: "Instagramを見る" },
  { key: "threads" as const, label: "Threadsを見る" },
].filter((link) => socialLinks[link.key]);

const snsInviteHeading = "SNSでも活動を発信しています";
const snsInviteDescription =
  "福富千恵と延岡を動かす会の活動や最新のお知らせを、FacebookとInstagramで発信しています。";

const schemas = [
  webPageSchema({ path: "/activities", name: title, description }),
  buildBreadcrumbList(breadcrumbItems),
];
---

<BaseLayout title={title} description={description} path="/activities" schemas={schemas}>
  <Breadcrumb items={breadcrumbItems} />
  <HeroSection title="活動報告" description="福富千恵と延岡を動かす会の地域活動をお伝えします。Facebook・Instagramの投稿もあわせてご覧いただけます。" />

  <section class="pt-10 sm:pt-14">
    <div class="section-wrap">
      <a href="/photos/" class="card flex items-center gap-4 hover:shadow-md transition-shadow">
        <span class="flex items-center justify-center w-12 h-12 rounded-full bg-brand-orange-light text-brand-orange-dark flex-shrink-0">
          <Icon name="document" class="w-6 h-6" />
        </span>
        <span class="min-w-0">
          <span class="block font-bold text-ink">活動写真を見る</span>
          <span class="block text-sm text-ink-soft">現場での活動の様子を写真でご紹介しています。</span>
        </span>
      </a>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="section-wrap">
      <h2 class="sr-only">活動報告一覧</h2>
      <ActivityFilterBar />

      <div
        data-sns-fetch-error-container
        data-facebook-url={socialLinks.facebook ?? ""}
        data-instagram-url={socialLinks.instagram ?? ""}
      ></div>

      <div
        id="activity-grid"
        role="tabpanel"
        aria-labelledby="activity-tab-all"
        aria-live="polite"
        class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 items-start"
        data-activity-grid
        data-instagram-username={socialConfig.instagramUsername}
      >
        {unifiedActivities.map((item) => {
          if (item.kind === "website") {
            return (
              <div data-activity-card data-platforms="website" data-date={item.date.toISOString()}>
                <ActivityCard
                  slug={item.entry.slug}
                  title={item.entry.data.title}
                  date={item.entry.data.date}
                  category={item.entry.data.category}
                  summary={item.entry.data.summary}
                  mainImage={item.entry.data.mainImage}
                />
              </div>
            );
          }
          if (item.kind === "social") {
            return <SocialPostCard post={item.entry} instagramUsername={socialConfig.instagramUsername} />;
          }
          return <SnsActivityCard entry={item.entry} />;
        })}
      </div>

      <div class="mt-8 flex justify-center">
        <button
          type="button"
          data-activity-load-more
          class="hidden btn-secondary"
        >
          もっと見る
        </button>
      </div>

      {!hasAnyActivity && (
        <div data-empty-for="all" class="mt-6 card text-center py-16 text-ink-soft flex flex-col items-center gap-6">
          <Icon name="document" class="w-10 h-10 text-brand-orange" />
          <p class="text-lg">活動報告は準備中です。</p>
          <div data-sns-invite>
            <p class="font-bold text-ink">{snsInviteHeading}</p>
            <p class="mt-1">{snsInviteDescription}</p>
          </div>
          {officialSnsLinks.length > 0 && (
            <div data-sns-invite class="flex flex-wrap justify-center gap-3">
              {officialSnsLinks.map((link) => (
                <a href={socialLinks[link.key]} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                  {link.label}
                  <span class="sr-only">（新しいタブで開く）</span>
                </a>
              ))}
            </div>
          )}
        </div>
      )}

      {!hasWebsite && (
        <div data-empty-for="website" class="mt-6 card text-center py-10 text-ink-soft flex flex-col items-center gap-3">
          <Icon name="document" class="w-8 h-8 text-brand-orange" />
          <p>公式サイトでの活動報告は準備中です。</p>
        </div>
      )}

      {!hasFacebook && (
        <div data-empty-for="facebook" class="mt-6">
          <div class="card text-center py-10 flex flex-col items-center gap-4">
            <Icon name="facebook" class="w-8 h-8 text-sns-facebook" />
            <div data-sns-invite>
              <p class="font-bold text-ink">{snsInviteHeading}</p>
              <p class="mt-1 text-ink-soft">{snsInviteDescription}</p>
            </div>
            {officialSnsLinks.length > 0 && (
              <div data-sns-invite class="flex flex-wrap justify-center gap-3">
                {officialSnsLinks.map((link) => (
                  <a href={socialLinks[link.key]} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                    {link.label}
                    <span class="sr-only">（新しいタブで開く）</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      )}

      {!hasInstagram && (
        <div data-empty-for="instagram" class="mt-6">
          <div class="card text-center py-10 flex flex-col items-center gap-4">
            <Icon name="instagram" class="w-8 h-8 text-brand-orange-dark" />
            <div data-sns-invite>
              <p class="font-bold text-ink">{snsInviteHeading}</p>
              <p class="mt-1 text-ink-soft">{snsInviteDescription}</p>
            </div>
            {officialSnsLinks.length > 0 && (
              <div data-sns-invite class="flex flex-wrap justify-center gap-3">
                {officialSnsLinks.map((link) => (
                  <a href={socialLinks[link.key]} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                    {link.label}
                    <span class="sr-only">（新しいタブで開く）</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      )}

      {!hasThreads && (
        <div data-empty-for="threads" class="mt-6">
          <div class="card text-center py-10 flex flex-col items-center gap-4">
            <Icon name="threads" class="w-8 h-8 text-ink" />
            <div data-sns-invite>
              <p class="font-bold text-ink">{snsInviteHeading}</p>
              <p class="mt-1 text-ink-soft">{snsInviteDescription}</p>
            </div>
            {officialSnsLinks.length > 0 && (
              <div data-sns-invite class="flex flex-wrap justify-center gap-3">
                {officialSnsLinks.map((link) => (
                  <a href={socialLinks[link.key]} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                    {link.label}
                    <span class="sr-only">（新しいタブで開く）</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchSocialPosts } from "../../services/socialPosts";
  import { createSocialPostCardElement } from "../../scripts/socialPostCard";
  import { registerActivityImageFallback } from "../../scripts/activityImageFallback";
  import { getExistingActivityLinks, insertActivityCardSorted } from "../../scripts/activityGrid";

  const grid = document.querySelector<HTMLElement>("[data-activity-grid]");

  // ビルド時に出力された投稿カードの画像読み込み失敗フォールバックを有効化する
  registerActivityImageFallback();

  /**
   * Meta APIへの取得自体が失敗した場合にだけ表示する案内バナー。
   * ビルド時点では成否が分からないため、hiddenで常に置いておくのではなく、
   * 実際に失敗したときだけDOMを生成する。
   */
  function createFetchErrorBanner(container: HTMLElement): HTMLElement {
    const banner = document.createElement("div");
    banner.dataset.snsFetchError = "";
    banner.className =
      "mb-6 rounded-xl border-2 border-brand-orange-dark/30 bg-brand-orange-light/40 p-4 flex flex-col sm:flex-row sm:items-center gap-3";
    banner.setAttribute("role", "status");

    const text = document.createElement("p");
    text.className = "text-sm text-ink";
    text.append("現在、SNSの最新投稿を読み込めません。");
    text.append(document.createElement("br"));
    text.append("最新の活動は、FacebookまたはInstagramからご覧いただけます。");
    banner.append(text);

    const facebookUrl = container.dataset.facebookUrl;
    const instagramUrl = container.dataset.instagramUrl;
    const links: { url: string; label: string }[] = [];
    if (facebookUrl) links.push({ url: facebookUrl, label: "Facebookを見る" });
    if (instagramUrl) links.push({ url: instagramUrl, label: "Instagramを見る" });

    if (links.length > 0) {
      const linkWrap = document.createElement("div");
      linkWrap.className = "flex flex-wrap gap-2 sm:ml-auto";
      for (const link of links) {
        const a = document.createElement("a");
        a.href = link.url;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.className = "btn-secondary text-sm py-1.5 px-4";
        a.append(link.label);
        const sr = document.createElement("span");
        sr.className = "sr-only";
        sr.append("（新しいタブで開く）");
        a.append(sr);
        linkWrap.append(a);
      }
      banner.append(linkWrap);
    }

    return banner;
  }

  /** 取得中であることを示す、既存カードと同じ配色のスケルトンカードを作る */
  function createSkeletonCard(): HTMLElement {
    const card = document.createElement("div");
    card.className = "card p-0 overflow-hidden flex flex-col h-full animate-pulse";
    card.dataset.activityCard = "";
    card.dataset.activitySkeleton = "";
    card.dataset.platforms = "facebook instagram";

    const media = document.createElement("div");
    media.className = "h-[200px] sm:h-60 bg-brand-orange-light/60";
    card.append(media);

    const body = document.createElement("div");
    body.className = "p-6 flex flex-col gap-3 flex-1";
    const badge = document.createElement("div");
    badge.className = "h-6 w-28 rounded-full bg-brand-orange-light/60";
    const titleLine = document.createElement("div");
    titleLine.className = "h-5 w-full rounded bg-brand-orange-light/60";
    const textLine = document.createElement("div");
    textLine.className = "h-4 w-2/3 rounded bg-brand-orange-light/60";
    body.append(badge, titleLine, textLine);
    card.append(body);

    return card;
  }

  (async () => {
    // 表示のたびにMeta Graph APIへ直接アクセスすることはせず、Cloudflare側で
    // キャッシュ・正規化済みの /api/social-feed から結果を読み込むだけ。
    const skeletons = grid ? [createSkeletonCard(), createSkeletonCard(), createSkeletonCard()] : [];
    skeletons.forEach((s) => grid?.append(s));
    if (skeletons.length > 0) document.dispatchEvent(new CustomEvent("social-posts:updated"));

    const { posts, fetchFailed } = await fetchSocialPosts();

    skeletons.forEach((s) => s.remove());

    const instagramUsername = grid?.dataset.instagramUsername;

    if (grid && posts.length > 0) {
      const known = getExistingActivityLinks(grid);
      for (const post of posts) {
        // 手動登録済みの投稿（src/data/snsActivities.ts）と同じURLの場合は重複させない
        if (known.has(post.permalink)) continue;
        const card = createSocialPostCardElement(post, instagramUsername);
        card.dataset.date = post.publishedAt;
        insertActivityCardSorted(grid, card, post.publishedAt);
        known.add(post.permalink);
      }
    }

    // Meta APIへの取得自体が失敗した場合のみ案内を出す（未設定の場合は既存の空表示に任せる）
    const errorContainer = document.querySelector<HTMLElement>("[data-sns-fetch-error-container]");
    if (errorContainer) {
      const existingBanner = errorContainer.querySelector<HTMLElement>("[data-sns-fetch-error]");
      if (fetchFailed && !existingBanner) {
        errorContainer.append(createFetchErrorBanner(errorContainer));
      } else if (!fetchFailed && existingBanner) {
        existingBanner.remove();
      }
    }

    // 取得失敗時は、上のエラー案内（Facebook/Instagramボタン付き）とほぼ同内容の
    // 「SNSでも活動を発信しています」案内が空状態カード内にも重複して表示されて
    // しまうため、取得失敗時だけそちらを隠す（未設定・0件時はこれまで通り表示する）。
    document.querySelectorAll<HTMLElement>("[data-sns-invite]").forEach((el) => {
      el.classList.toggle("hidden", fetchFailed);
    });

    // 投稿が0件・取得失敗の場合でも、既存の絞り込み状態を再評価してもらう
    document.dispatchEvent(new CustomEvent("social-posts:updated"));
  })();
</script>
