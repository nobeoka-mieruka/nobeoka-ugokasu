---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/HeroSection.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { webPageSchema } from "../../utils/structuredData";
import { buildBreadcrumbList } from "../../utils/seo";
import { getFileNewsItems } from "../../data/news";
import { renderNewsList, sortNews } from "../../utils/newsCards";

const title = "お知らせ｜福富千恵と延岡を動かす会";
const description = "福富千恵と延岡を動かす会からのお知らせ一覧です。活動予定、意見交換会、サイト更新情報などをお伝えします。";
const breadcrumbItems = [{ name: "お知らせ", path: "/news" }];

// 静的HTMLにはファイル由来のお知らせ（記事など）だけを入れておき、配信時に functions/news/index.ts が
// D1（執行部ポータル /staff/news/ で登録）のお知らせとまとめて差し替える（HTMLはトップページと共通）。
const newsFallbackHtml = renderNewsList(sortNews(await getFileNewsItems()));

const schemas = [
  webPageSchema({ path: "/news", name: title, description }),
  buildBreadcrumbList(breadcrumbItems),
];
---

<BaseLayout title={title} description={description} path="/news" schemas={schemas}>
  <Breadcrumb items={breadcrumbItems} />
  <HeroSection title="お知らせ" description="福富千恵と延岡を動かす会からのお知らせです。" />

  <section class="py-14 sm:py-20">
    <div class="section-wrap">
      {/* 見出し階層をh1→h2→h3の順に保つための、視覚的には表示しない見出し（13章） */}
      <h2 class="sr-only">お知らせ一覧</h2>
      <div data-news-list set:html={newsFallbackHtml} />
    </div>
  </section>
</BaseLayout>
