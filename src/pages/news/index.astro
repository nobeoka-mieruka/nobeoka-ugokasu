---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/HeroSection.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import NewsCard from "../../components/NewsCard.astro";
import Icon from "../../components/Icon.astro";
import { webPageSchema } from "../../utils/structuredData";
import { buildBreadcrumbList } from "../../utils/seo";
import { getUnifiedNews } from "../../data/news";

const title = "お知らせ｜福富千恵と延岡を動かす会";
const description = "福富千恵と延岡を動かす会からのお知らせ一覧です。活動予定、意見交換会、サイト更新情報などをお伝えします。";
const breadcrumbItems = [{ name: "お知らせ", path: "/news" }];

// トップページと共通の取得口（src/data/news.ts）を使う
const news = await getUnifiedNews();

const schemas = [
  webPageSchema({ path: "/news", name: title, description }),
  buildBreadcrumbList(breadcrumbItems),
];
---

<BaseLayout title={title} description={description} path="/news" schemas={schemas}>
  <Breadcrumb items={breadcrumbItems} />
  <HeroSection title="お知らせ" description="福富千恵と延岡を動かす会からのお知らせです。" />

  <section class="py-14 sm:py-20">
    <div class="section-wrap">
      {/* 見出し階層をh1→h2→h3の順に保つための、視覚的には表示しない見出し（13章） */}
      <h2 class="sr-only">お知らせ一覧</h2>
      {news.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {news.map((entry) => <NewsCard entry={entry} />)}
        </div>
      ) : (
        <div class="card text-center py-16 text-ink-soft flex flex-col items-center gap-3">
          <Icon name="document" class="w-10 h-10 text-brand-orange" />
          <p class="text-lg">新しいお知らせは、公開次第こちらに掲載します。</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
