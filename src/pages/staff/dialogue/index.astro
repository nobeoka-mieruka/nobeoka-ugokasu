---
// /staff/dialogue/ … 意見交換会の管理一覧（ログイン必須。functions/staff/_middleware.ts が保護）
// 一覧の内容はビルド時には含めず、ブラウザが /staff/api/dialogue-events から読み込みます。
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StaffPageHeader from "../../../components/staff/StaffPageHeader.astro";
import { DIALOGUE_STATUSES, DIALOGUE_STATUS_LABELS } from "../../../types/dialogue";

const termClass = "text-xs font-bold text-ink-soft";
---

<BaseLayout title="意見交換会の管理｜執行部ポータル" description="意見交換会の開催予定を管理します。" path="/staff/dialogue" noindex>
  <StaffPageHeader
    title="意見交換会の管理"
    description="ここで登録・変更した内容は、公開ページ（/dialogue/）にすぐ反映されます。"
  />

  <section class="py-10 sm:py-14">
    <div class="section-wrap max-w-5xl space-y-6">
      <input type="hidden" name="csrf_token" value="" />
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <a href="/staff/dialogue/new/" class="btn-primary justify-center">＋ 新しい意見交換会を登録</a>
        <a href="/dialogue/" target="_blank" rel="noopener" class="text-sm font-bold text-ink underline">公開ページを確認する（新しいタブ）</a>
      </div>

      <div data-staff-notice role="status" tabindex="-1" class="hidden rounded-xl px-4 py-3 font-bold"></div>

      <p data-dialogue-loading class="text-ink-soft">読み込んでいます…</p>
      <p data-dialogue-empty class="hidden card text-center text-ink-soft">登録されている意見交換会はありません。「新しい意見交換会を登録」から追加してください。</p>
      <ul data-dialogue-list class="grid grid-cols-1 lg:grid-cols-2 gap-5"></ul>
    </div>
  </section>

  <template data-dialogue-card-template>
    <li class="card min-w-0 flex flex-col gap-4">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <h2 data-field="title" class="text-xl font-bold text-ink [overflow-wrap:anywhere]"></h2>
        <span data-field="published" class="rounded-full px-3 py-1 text-xs font-bold"></span>
      </div>
      <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-ink">
        <div><dt class={termClass}>開催日</dt><dd data-field="date" class="font-bold"></dd></div>
        <div><dt class={termClass}>時間</dt><dd data-field="time"></dd></div>
        <div class="col-span-2"><dt class={termClass}>会場</dt><dd data-field="venue" class="[overflow-wrap:anywhere]"></dd></div>
        <div><dt class={termClass}>受付状況</dt><dd data-field="status" class="font-bold"></dd></div>
        <div><dt class={termClass}>定員</dt><dd data-field="capacity"></dd></div>
        <div class="col-span-2"><dt class={termClass}>申込ボタン</dt><dd data-field="apply"></dd></div>
      </dl>
      <form data-status-form class="flex flex-wrap items-end gap-2 rounded-xl bg-brand-ivory p-3">
        <label class="flex-1 min-w-[10rem] text-sm font-bold text-ink">
          受付状況を変更
          <select name="status" class="mt-1 block w-full rounded-lg border border-black/20 bg-white px-3 py-2 text-base">
            {DIALOGUE_STATUSES.map((status) => <option value={status}>{DIALOGUE_STATUS_LABELS[status]}</option>)}
          </select>
        </label>
        <button type="submit" class="rounded-full border-2 border-brand-orange-dark px-4 py-2 text-base font-bold text-brand-orange-dark hover:bg-brand-orange-light">変更</button>
      </form>
      <div class="mt-auto flex gap-3">
        <a data-edit-link href="/staff/dialogue/" class="btn-secondary flex-1 justify-center text-lg">編集</a>
        <button type="button" data-delete class="flex-1 rounded-full border-2 border-red-700 px-6 py-3 text-lg font-bold text-red-700 hover:bg-red-50">削除</button>
      </div>
    </li>
  </template>

  <dialog data-delete-dialog aria-labelledby="delete-dialog-title" class="w-[calc(100%-2rem)] max-w-md rounded-2xl p-0 backdrop:bg-black/50">
    <form method="dialog" class="p-6 sm:p-8 space-y-4">
      <h2 id="delete-dialog-title" class="text-xl font-bold text-ink">この意見交換会を削除しますか？</h2>
      <p class="rounded-xl bg-brand-ivory px-4 py-3 text-ink [overflow-wrap:anywhere]">
        <span data-delete-date class="block font-bold"></span>
        <span data-delete-title class="block"></span>
      </p>
      <p class="text-sm text-ink-soft leading-relaxed">削除すると、一覧と公開ページ（/dialogue/）から表示されなくなります。</p>
      <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
        <button value="cancel" class="btn-secondary justify-center text-lg" autofocus>やめる</button>
        <button value="confirm" class="rounded-full bg-red-700 px-6 py-3 text-lg font-bold text-white hover:brightness-110">削除する</button>
      </div>
    </form>
  </dialog>

  <script>
    import "../../../scripts/staff/dialogueList";
  </script>
</BaseLayout>
