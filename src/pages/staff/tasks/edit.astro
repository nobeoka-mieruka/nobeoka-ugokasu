---
// /staff/tasks/:id/edit/ … タスクの編集（ログイン必須。functions/staff/_middleware.ts が保護）
// functions/staff/tasks/[id]/edit.ts がこのページのHTMLを返し、内容はブラウザがAPIから読み込みます。
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StaffPageHeader from "../../../components/staff/StaffPageHeader.astro";
import TaskForm from "../../../components/staff/TaskForm.astro";
---

<BaseLayout title="タスクの編集｜執行部ポータル" description="タスクを編集します。" path="/staff/tasks/edit" noindex>
  <StaffPageHeader title="タスクの編集" backHref="/staff/tasks/" backLabel="タスクの一覧へ戻る" />
  <section class="py-10 sm:py-14">
    <div class="section-wrap max-w-3xl space-y-6">
      <div data-staff-notice role="status" tabindex="-1" class="hidden rounded-xl px-4 py-3 font-bold"></div>
      <TaskForm mode="edit" />
    </div>
  </section>
  <script>
    import "../../../scripts/staff/taskForm";
  </script>
</BaseLayout>
