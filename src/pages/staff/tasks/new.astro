---
// /staff/tasks/new/ … タスクの新規登録（ログイン必須。functions/staff/_middleware.ts が保護）
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StaffPageHeader from "../../../components/staff/StaffPageHeader.astro";
import TaskForm from "../../../components/staff/TaskForm.astro";
---

<BaseLayout title="タスクの新規登録｜執行部ポータル" description="タスクを登録します。" path="/staff/tasks/new" noindex>
  <StaffPageHeader title="タスクの新規登録" backHref="/staff/tasks/" backLabel="タスクの一覧へ戻る" />
  <section class="py-10 sm:py-14">
    <div class="section-wrap max-w-3xl space-y-6">
      <div data-staff-notice role="status" tabindex="-1" class="hidden rounded-xl px-4 py-3 font-bold"></div>
      <TaskForm mode="create" />
    </div>
  </section>
  <script>
    import "../../../scripts/staff/taskForm";
  </script>
</BaseLayout>
