---
// 後援会執行部ポータル（/staff/）。
// functions/staff/_middleware.ts がセッションを確認し、ログイン済みの方にだけ配信します。
// ログイン中のメールアドレス（data-staff-email）とCSRFトークン（csrf_token）は、
// 配信時にミドルウェアが差し込みます。
//
// 【重要】このファイルはビルド時に静的HTMLになります。申込者の氏名・電話番号・
// フォーム回答・内部資料などの非公開データを直接書かないでください。
// 非公開データは /staff/api/ 配下にAPIを作り、ログイン後に取得して表示してください
//（/staff/api/ もミドルウェアで保護されます）。
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import type { IconName } from "../../types/icon";

const title = "後援会執行部ポータル｜福富千恵と延岡を動かす会";
const description = "福富千恵と延岡を動かす会 後援会執行部向けのページです。";

interface PortalCard {
  title: string;
  description: string;
  icon: IconName;
  /** 実装済みの機能へのリンク。未実装の間は undefined（「準備中」と表示） */
  href?: string;
}

const cards: PortalCard[] = [
  { title: "意見交換会", description: "開催予定の登録・編集・受付状況の変更（公開ページ /dialogue/ へ反映）", icon: "users", href: "/staff/dialogue/" },
  { title: "お知らせ管理", description: "トップページ「最新のお知らせ」の登録・編集・公開／非公開", icon: "document", href: "/staff/news/" },
  { title: "イベント", description: "活動予定・イベントの管理", icon: "clock" },
  { title: "タスク", description: "執行部内のやること・担当の管理", icon: "check" },
  { title: "SNS", description: "SNS投稿の同期状況の確認", icon: "megaphone" },
  { title: "資料", description: "執行部内の資料の共有", icon: "document" },
];
---

<BaseLayout title={title} description={description} path="/staff" noindex>
  <div class="bg-brand-orange-light">
    <div class="section-wrap py-8 sm:py-10">
      <p class="text-base font-bold text-ink">後援会執行部</p>
      <h1 class="mt-1 text-3xl sm:text-4xl font-bold text-ink">執行部ポータル</h1>
      <p class="mt-3 text-sm text-ink-soft [overflow-wrap:anywhere]">
        ログイン中：<span data-staff-email></span>
      </p>
    </div>
  </div>

  <section class="py-12 sm:py-16">
    <div class="section-wrap max-w-5xl">
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {cards.map((card) => (
          <li class="card min-w-0 flex flex-col">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center justify-center w-12 h-12 rounded-full bg-brand-orange-light">
                <Icon name={card.icon} class="w-6 h-6 text-brand-orange-dark" />
              </div>
              {card.href ? (
                <span class="rounded-full bg-brand-orange-dark px-3 py-1 text-xs font-bold text-white">利用可能</span>
              ) : (
                <span class="rounded-full bg-black/5 px-3 py-1 text-xs font-bold text-ink-soft">準備中</span>
              )}
            </div>
            <h2 class="mt-4 text-xl font-bold text-ink">{card.title}</h2>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{card.description}</p>
            {card.href && (
              <div class="mt-auto pt-4">
                <a href={card.href} class="btn-secondary">開く</a>
              </div>
            )}
          </li>
        ))}

        <li class="card min-w-0 flex flex-col border-2 border-brand-orange-dark/30">
          <div class="flex items-center justify-center w-12 h-12 rounded-full bg-brand-orange-light">
            <Icon name="arrow-right" class="w-6 h-6 text-brand-orange-dark" />
          </div>
          <h2 class="mt-4 text-xl font-bold text-ink">ログアウト</h2>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">
            共用のパソコン・スマートフォンでは、使い終わったら必ずログアウトしてください。
          </p>
          <form method="post" action="/staff/logout" class="mt-auto pt-4">
            <input type="hidden" name="csrf_token" value="" />
            <button type="submit" class="btn-primary w-full justify-center">ログアウト</button>
          </form>
        </li>
      </ul>

      <div class="mt-10 card border-l-4 border-brand-orange">
        <h2 class="text-lg font-bold text-ink">ご利用にあたって</h2>
        <ul class="mt-3 space-y-2 text-sm text-ink-soft leading-relaxed list-disc list-inside">
          <li>ログインの有効期限は12時間です。期限が切れた場合は、もう一度ログインしてください。</li>
          <li>このページに表示される情報を、執行部以外の方へ共有しないでください。</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
