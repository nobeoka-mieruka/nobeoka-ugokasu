---
// /staff/news/new/ … お知らせの新規登録（ログイン必須。functions/staff/_middleware.ts が保護）
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StaffPageHeader from "../../../components/staff/StaffPageHeader.astro";
import NewsItemForm from "../../../components/staff/NewsItemForm.astro";
---

<BaseLayout title="お知らせの新規登録｜執行部ポータル" description="最新のお知らせを登録します。" path="/staff/news/new" noindex>
  <StaffPageHeader title="お知らせの新規登録" backHref="/staff/news/" backLabel="お知らせの一覧へ戻る" />
  <section class="py-10 sm:py-14">
    <div class="section-wrap max-w-3xl space-y-6">
      <div data-staff-notice role="status" tabindex="-1" class="hidden rounded-xl px-4 py-3 font-bold"></div>
      <NewsItemForm mode="create" />
    </div>
  </section>
  <script>
    import "../../../scripts/staff/newsForm";
  </script>
</BaseLayout>
