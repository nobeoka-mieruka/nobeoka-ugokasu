---
// /staff/status/ … サイトの状態（ログイン必須。functions/staff/_middleware.ts が保護）
// 本番デプロイ・お知らせ・SNS取得・RSSの状態を「正常／要確認／失敗」で表示します。
// 状態はブラウザが /staff/api/site-status から読み込みます（server/siteHealth.ts）。秘密情報は含まれません。
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StaffPageHeader from "../../../components/staff/StaffPageHeader.astro";
---

<BaseLayout title="サイトの状態｜執行部ポータル" description="ホームページの自動更新の状態を確認します。" path="/staff/status" noindex>
  <StaffPageHeader
    title="サイトの状態"
    description="ホームページの自動更新（デプロイ・お知らせ・SNS取得・RSS）がうまく動いているかを確認できます。定期チェックは1時間ごとです。"
  />

  <section class="py-10 sm:py-14">
    <div class="section-wrap max-w-5xl space-y-6">
      <div data-staff-notice role="status" tabindex="-1" class="hidden rounded-xl px-4 py-3 font-bold"></div>

      <div class="card flex flex-col sm:flex-row sm:items-center gap-4">
        <div class="min-w-0 flex-1 space-y-1 text-sm text-ink">
          <p class="text-lg font-bold" data-status-overall>読み込んでいます…</p>
          <p class="text-ink-soft">
            <span class="font-bold">正常</span> <span data-status-count="ok">—</span>件／
            <span class="font-bold">要確認</span> <span data-status-count="warning">—</span>件／
            <span class="font-bold">失敗</span> <span data-status-count="error">—</span>件
          </p>
          <p class="text-ink-soft">表示した日時：<span data-status-generated>—</span></p>
        </div>
        <button type="button" data-status-reload class="btn-secondary justify-center">最新の状態に更新</button>
      </div>

      <ul data-status-items class="grid grid-cols-1 md:grid-cols-2 gap-4"></ul>

      <div class="space-y-3">
        <h2 class="text-2xl font-bold text-ink">最近の異常の記録</h2>
        <p class="text-sm text-ink-soft">定期チェックで「正常」から「要確認」「失敗」に変わったときの記録です（新しい順に最大10件）。</p>
        <p data-status-history-empty class="hidden card text-center text-ink-soft">異常の記録はありません。</p>
        <ul data-status-history class="divide-y divide-black/5 rounded-2xl bg-white ring-1 ring-black/5"></ul>
      </div>

      <p class="text-sm text-ink-soft">
        ホームページのアクセス数は<a href="/staff/analytics/" class="underline font-bold text-ink">アクセス解析</a>で確認できます。
      </p>

      <div class="card space-y-2 text-sm text-ink-soft">
        <h2 class="text-lg font-bold text-ink">表示の見方</h2>
        <p><span class="font-bold text-ink">正常</span>：対応は不要です。</p>
        <p><span class="font-bold text-ink">要確認</span>：確認待ちのお知らせがある、記録がまだ無いなど、内容の確認が必要です。</p>
        <p><span class="font-bold text-ink">失敗</span>：自動更新が止まっています。説明に沿って対応してください（SNSのトークン更新は管理者が行います）。</p>
      </div>
    </div>
  </section>

  <template data-status-item-template>
    <li class="card min-w-0 flex flex-col gap-2" data-status-item>
      <div class="flex items-start justify-between gap-3">
        <h2 data-field="label" class="text-lg font-bold text-ink"></h2>
        <span data-field="state" class="flex-shrink-0 rounded-full px-3 py-1 text-xs font-bold"></span>
      </div>
      <p data-field="summary" class="text-sm text-ink [overflow-wrap:anywhere]"></p>
      <p data-field="at" class="text-sm text-ink-soft"></p>
      <a data-field="task" href="/staff/tasks/new/" class="hidden mt-auto self-start inline-flex min-h-[44px] items-center text-sm font-bold text-ink underline">タスクに登録</a>
    </li>
  </template>

  <template data-status-history-template>
    <li class="flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-4 px-5 py-4">
      <span data-history="at" class="text-sm text-ink-soft whitespace-nowrap"></span>
      <span data-history="state" class="w-fit rounded-full px-2.5 py-0.5 text-xs font-bold"></span>
      <span class="min-w-0 flex-1 text-sm text-ink [overflow-wrap:anywhere]"><span data-history="label" class="font-bold"></span>：<span data-history="summary"></span></span>
    </li>
  </template>

  <script>
    import "../../../scripts/staff/siteStatus";
  </script>
</BaseLayout>
