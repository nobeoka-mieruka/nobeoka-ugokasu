---
// /staff/events/new/ … イベントの新規登録（ログイン必須。functions/staff/_middleware.ts が保護）
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StaffPageHeader from "../../../components/staff/StaffPageHeader.astro";
import EventForm from "../../../components/staff/EventForm.astro";
---

<BaseLayout title="イベントの新規登録｜執行部ポータル" description="イベントを登録します。" path="/staff/events/new" noindex>
  <StaffPageHeader title="イベントの新規登録" backHref="/staff/events/" backLabel="イベントの一覧へ戻る" />
  <section class="py-10 sm:py-14">
    <div class="section-wrap max-w-3xl space-y-6">
      <div data-staff-notice role="status" tabindex="-1" class="hidden rounded-xl px-4 py-3 font-bold"></div>
      <EventForm mode="create" />
    </div>
  </section>
  <script>
    import "../../../scripts/staff/eventForm";
  </script>
</BaseLayout>
