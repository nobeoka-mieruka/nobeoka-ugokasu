---
// /staff/events/:id/edit/ … イベントの編集（ログイン必須。functions/staff/_middleware.ts が保護）
// functions/staff/events/[id]/edit.ts がこのページのHTMLを返し、内容はブラウザがAPIから読み込みます。
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StaffPageHeader from "../../../components/staff/StaffPageHeader.astro";
import EventForm from "../../../components/staff/EventForm.astro";
---

<BaseLayout title="イベントの編集｜執行部ポータル" description="イベントを編集します。" path="/staff/events/edit" noindex>
  <StaffPageHeader title="イベントの編集" backHref="/staff/events/" backLabel="イベントの一覧へ戻る" />
  <section class="py-10 sm:py-14">
    <div class="section-wrap max-w-3xl space-y-6">
      <div data-staff-notice role="status" tabindex="-1" class="hidden rounded-xl px-4 py-3 font-bold"></div>
      <EventForm mode="edit" />
    </div>
  </section>
  <script>
    import "../../../scripts/staff/eventForm";
  </script>
</BaseLayout>
