---
// /staff/documents/ … 資料（ログイン必須。functions/staff/_middleware.ts が保護）
// 執行部内部用の資料リンク集です。一覧の内容（タイトル・URLなど）はビルド時には含めず、
// ブラウザが /staff/api/documents から読み込みます（公開ページ・ビルド済みのファイルには含まれません）。
// PC（lg以上）は表、スマートフォンはカード。表の行（<tr>）の中では <form>・式の <option> を使わない。
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StaffPageHeader from "../../../components/staff/StaffPageHeader.astro";
import DriveSharingNotice from "../../../components/staff/DriveSharingNotice.astro";
import { DOCUMENT_CATEGORIES, DOCUMENT_CATEGORY_LABELS } from "../../../types/documents";

const th = "px-3 py-3 text-left text-sm font-bold text-ink-soft whitespace-nowrap";
const td = "px-3 py-3 align-top text-sm text-ink";
const smallButton = "rounded-full border-2 px-3 py-1.5 text-sm font-bold whitespace-nowrap";
---

<BaseLayout title="資料｜執行部ポータル" description="執行部内の資料を整理します。" path="/staff/documents" noindex>
  <StaffPageHeader title="資料" description="Google Drive などに置いてある執行部の資料へのリンクを整理します。ここの内容は公開ページには表示されません。" />

  <section class="py-10 sm:py-14">
    <div class="section-wrap max-w-6xl space-y-6">
      <input type="hidden" name="csrf_token" value="" />
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <a href="/staff/documents/new/" class="btn-primary justify-center">＋ 新しい資料を登録</a>
        <label class="text-sm font-bold text-ink">
          カテゴリーで絞り込む
          <select data-category-filter class="ml-2 rounded-lg border border-black/20 bg-white px-3 py-2 text-base">
            <option value="">すべて</option>
            {DOCUMENT_CATEGORIES.map((category) => <option value={category}>{DOCUMENT_CATEGORY_LABELS[category]}</option>)}
          </select>
        </label>
      </div>

      <DriveSharingNotice />

      <div data-staff-notice role="status" tabindex="-1" class="hidden rounded-xl px-4 py-3 font-bold"></div>
      <p data-documents-loading class="text-ink-soft">読み込んでいます…</p>
      <p data-documents-empty class="hidden card text-center text-ink-soft">登録されている資料はありません。</p>

      <div data-documents-table class="hidden overflow-hidden rounded-2xl bg-white ring-1 ring-black/5">
        <table class="w-full">
          <thead class="bg-brand-ivory">
            <tr>
              <th scope="col" class={th}><span class="sr-only">ピン留め</span></th>
              <th scope="col" class={th}>カテゴリー</th>
              <th scope="col" class={th}>タイトル</th>
              <th scope="col" class={th}>種類</th>
              <th scope="col" class={th}>更新日</th>
              <th scope="col" class={th}><span class="sr-only">操作</span></th>
            </tr>
          </thead>
          <tbody data-documents-rows class="divide-y divide-black/5"></tbody>
        </table>
      </div>
      <ul data-documents-cards class="lg:hidden grid grid-cols-1 sm:grid-cols-2 gap-5"></ul>
    </div>
  </section>

  <template data-document-row-template>
    <tr>
      <td class={td}><span data-field="pin" class="hidden rounded-full bg-brand-orange-dark px-2 py-0.5 text-xs font-bold text-white whitespace-nowrap">ピン留め</span></td>
      <td class={td}><span data-field="category" class="rounded-full bg-brand-orange-light px-2.5 py-1 text-xs font-bold whitespace-nowrap"></span></td>
      <td class={td}><span data-field="title" class="font-bold [overflow-wrap:anywhere]"></span><span data-field="description" class="block text-ink-soft whitespace-pre-line [overflow-wrap:anywhere]"></span></td>
      <td class={td}><span data-field="type" class="whitespace-nowrap"></span></td>
      <td class={td}><span data-field="updated" class="whitespace-nowrap"></span></td>
      <td class={`${td} whitespace-nowrap`}>
        <a data-open-link target="_blank" rel="noopener noreferrer" class={`${smallButton} inline-block border-brand-orange-dark bg-brand-orange-dark text-white`}>資料を開く<span class="sr-only">（新しいタブで開く）</span></a>
        <button type="button" data-toggle-pin class={`${smallButton} ml-1 border-brand-orange-dark text-brand-orange-dark hover:bg-brand-orange-light`}></button>
        <a data-edit-link href="/staff/documents/" class={`${smallButton} ml-1 inline-block border-brand-orange-dark text-brand-orange-dark hover:bg-brand-orange-light`}>編集</a>
        <button type="button" data-delete class={`${smallButton} ml-1 border-red-700 text-red-700 hover:bg-red-50`}>削除</button>
      </td>
    </tr>
  </template>

  <template data-document-card-template>
    <li class="card min-w-0 flex flex-col gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <span data-field="pin" class="hidden rounded-full bg-brand-orange-dark px-2.5 py-1 text-xs font-bold text-white">ピン留め</span>
        <span data-field="category" class="rounded-full bg-brand-orange-light px-2.5 py-1 text-xs font-bold"></span>
        <span data-field="type" class="rounded-full bg-black/5 px-2.5 py-1 text-xs font-bold text-ink-soft"></span>
      </div>
      <h2 data-field="title" class="text-xl font-bold text-ink [overflow-wrap:anywhere]"></h2>
      <p data-field="description" class="text-sm text-ink-soft whitespace-pre-line [overflow-wrap:anywhere]"></p>
      <p class="text-xs text-ink-soft">更新日：<span data-field="updated"></span></p>
      <div class="mt-auto grid grid-cols-2 gap-3">
        <a data-open-link target="_blank" rel="noopener noreferrer" class="btn-primary col-span-2 justify-center text-lg">資料を開く<span class="sr-only">（新しいタブで開く）</span></a>
        <button type="button" data-toggle-pin class="col-span-2 rounded-full border-2 border-brand-orange-dark px-4 py-2 text-base font-bold text-brand-orange-dark hover:bg-brand-orange-light"></button>
        <a data-edit-link href="/staff/documents/" class="btn-secondary justify-center text-lg">編集</a>
        <button type="button" data-delete class="rounded-full border-2 border-red-700 px-6 py-3 text-lg font-bold text-red-700 hover:bg-red-50">削除</button>
      </div>
    </li>
  </template>

  <dialog data-delete-dialog aria-labelledby="document-delete-title" class="w-[calc(100%-2rem)] max-w-md rounded-2xl p-0 backdrop:bg-black/50">
    <form method="dialog" class="p-6 sm:p-8 space-y-4">
      <h2 id="document-delete-title" class="text-xl font-bold text-ink">この資料を一覧から削除しますか？</h2>
      <p data-delete-title class="rounded-xl bg-brand-ivory px-4 py-3 font-bold text-ink [overflow-wrap:anywhere]"></p>
      <p class="text-sm text-ink-soft leading-relaxed">削除するのはこの一覧の登録だけです。Google Drive などにある資料そのものは削除されません。</p>
      <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
        <button value="cancel" class="btn-secondary justify-center text-lg" autofocus>やめる</button>
        <button value="confirm" class="rounded-full bg-red-700 px-6 py-3 text-lg font-bold text-white hover:brightness-110">削除する</button>
      </div>
    </form>
  </dialog>

  <script>
    import "../../../scripts/staff/documentList";
  </script>
</BaseLayout>
