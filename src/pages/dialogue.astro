---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Icon from "../components/Icon.astro";
import ContactEmails from "../components/ContactEmails.astro";
import WelfareDialogueSection from "../components/WelfareDialogueSection.astro";
import { dialogueConfig } from "../config/dialogueConfig";
import { webPageSchema, organizationSchema } from "../utils/structuredData";
import { buildBreadcrumbList } from "../utils/seo";
import { DIALOGUE_FORM_SECTION_ID, renderDialogueSchedule } from "../utils/dialogueSchedule";
import { todayInJapan } from "../utils/dialogueEvents";
import {
  WELFARE_DIALOGUE_OG_IMAGE,
  WELFARE_DIALOGUE_OG_IMAGE_ALT,
  welfareDialogueEventSchemas,
} from "../data/welfareDialogue";

const title = "意見交換会｜福祉の現場の声を聴く｜福富千恵と延岡を動かす会";
const description =
  "延岡市で福祉のお仕事に携わる皆さまを対象に、現場の声や仕事のやりがい、制度・働く環境、これからの福祉について語り合う意見交換会を開催します。福祉職・福祉従事者の皆さまのご参加をお待ちしています。";
const breadcrumbItems = [{ name: "意見交換会", path: "/dialogue" }];

// 開催予定はD1（執行部ポータル /staff/dialogue/ で登録）が正です。
// このページの静的HTMLには「日程調整中」の表示だけを入れておき、配信時に functions/dialogue/index.ts が
// D1の開催予定で [data-dialogue-schedule] の中身を差し替え、Event構造化データを追加します。
// （D1に障害がある場合は、この静的HTMLのまま表示されます）
const scheduleFallbackHtml = renderDialogueSchedule([], todayInJapan());

const schemas = [
  webPageSchema({ path: "/dialogue", name: title, description }),
  organizationSchema(),
  buildBreadcrumbList(breadcrumbItems),
  // 「福祉の現場の声を聴く 意見交換会」の各回（執行部ポータルで登録した回は functions/dialogue/index.ts が追加する）
  ...welfareDialogueEventSchemas(todayInJapan()),
];

const FORM_SECTION_ID = DIALOGUE_FORM_SECTION_ID;

const heroDescription = `あなたの声を、聞かせてください。

福富千恵と延岡を動かす会では、
延岡市の皆さまと直接お話しする「意見交換会」を開催しています。

暮らしの中で感じていること、地域の困りごと、
延岡をもっと良くするためのアイデアなど、
皆さまの声をお聞かせください。

一方的にお話しする場ではなく、
皆さまと一緒に延岡のこれからを考える場を目指しています。`;
---

<BaseLayout
  title={title}
  description={description}
  path="/dialogue"
  schemas={schemas}
  ogImage={WELFARE_DIALOGUE_OG_IMAGE}
  ogImageAlt={WELFARE_DIALOGUE_OG_IMAGE_ALT}
>
  <Breadcrumb items={breadcrumbItems} />
  <HeroSection title="意見交換会" description={heroDescription} />

  <!-- 福祉の現場の声を聴く 意見交換会（最新の開催案内） -->
  <WelfareDialogueSection />

  <!-- 今後の意見交換会 -->
  <section class="py-14 sm:py-20 bg-white border-t border-black/5" aria-labelledby="upcoming-heading">
    <div class="section-wrap max-w-5xl">
      <div id="upcoming-heading">
        <SectionTitle
          title="地域の意見交換会"
          subtitle="「福祉の現場の声を聴く 意見交換会」とは別に開催する、一般の方・地域の皆さま向けの意見交換会です。"
        />
      </div>

      <div data-dialogue-schedule set:html={scheduleFallbackHtml} />
    </div>
  </section>

  <!-- 意見交換会 参加申込 -->
  <section id={FORM_SECTION_ID} class="py-14 sm:py-20 bg-brand-ivory scroll-mt-24" aria-labelledby="form-heading">
    <div class="section-wrap max-w-3xl">
      <div id="form-heading">
        <SectionTitle title="意見交換会 参加申込" />
      </div>
      <div class="space-y-4 text-lg text-ink-soft leading-relaxed">
        <p>意見交換会への参加をご希望の方は、下記フォームからお申し込みください。</p>
        <p>フォームでは、3回の日程それぞれについて「参加する」「参加しない」をお選びいただけます。複数回の参加も可能です。</p>
        <p>お申し込み内容を確認後、必要に応じて後援会事務局からご連絡いたします。</p>
      </div>

      <p class="mt-6 inline-flex items-center gap-2 rounded-xl bg-white ring-1 ring-black/5 px-4 py-3 text-sm font-bold text-ink">
        <Icon name="check" class="w-5 h-5 flex-shrink-0 text-brand-orange-dark" />
        3回の日程それぞれ「参加する」「参加しない」を選べます
      </p>

      <div class="mt-8 text-center">
        <a
          href={dialogueConfig.formUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary w-full sm:w-auto justify-center"
        >
          フォームを別画面で開く
          <Icon name="external-link" class="w-5 h-5" />
          <span class="sr-only">（新しいタブで開く）</span>
        </a>
      </div>

      <p class="mt-6 rounded-xl bg-white ring-1 ring-black/5 px-4 py-3 text-sm text-ink-soft leading-relaxed">
        ご入力いただいた個人情報は、意見交換会のご連絡および運営のために使用します。詳しくは
        <a href="/privacy/" class="underline font-bold text-ink">プライバシーポリシー</a>
        をご確認ください。
      </p>

      <div class="mt-6 rounded-2xl overflow-hidden ring-1 ring-black/5 bg-white w-full">
        <iframe
          src={dialogueConfig.formEmbedUrl}
          title={dialogueConfig.formTitle}
          width="100%"
          class="dialogue-form-frame w-full max-w-full block"
          style="border: 0;"
          loading="lazy"
        >
          フォームを読み込んでいます…
        </iframe>
      </div>

      <p class="mt-3 text-center text-sm text-ink-soft">
        フォームが正しく表示されない場合は、
        <a href={dialogueConfig.formUrl} target="_blank" rel="noopener noreferrer" class="underline font-bold text-ink">
          こちらから申込フォームを開いてください
          <span class="sr-only">（新しいタブで開く）</span>
        </a>
        。
      </p>

      <div class="mt-10 card border-l-4 border-brand-orange">
        <h3 class="font-bold text-ink mb-2">意見交換会に関するお問い合わせ</h3>
        <p class="text-sm text-ink-soft leading-relaxed">
          開催内容や申込についてのご質問は、後援会事務局までご連絡ください。
        </p>
        <div class="mt-3">
          <ContactEmails variant="compact" />
        </div>
      </div>
    </div>
  </section>

  <style>
    /*
     * Googleフォーム全体をiframe内でスクロールせずに見渡せる高さ（実測：PC約2,130px／スマホ約2,580px。2026年10月の各回参加方式のフォーム）。
     * 設問を増減した場合はこの値も見直してください。
     */
    .dialogue-form-frame {
      height: 2700px;
    }
    @media (min-width: 640px) {
      .dialogue-form-frame {
        height: 2250px;
      }
    }
  </style>

  <script>
    // 「参加を申し込む」から申込フォームへスムーズスクロールする。
    // 動きを減らす設定の利用者には即時移動にし、JavaScript無効時は通常のページ内リンクとして動作する。
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLAnchorElement>("[data-scroll-to-form]").forEach((link) => {
      link.addEventListener("click", (event) => {
        const target = document.getElementById(link.hash.slice(1));
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth", block: "start" });
        history.replaceState(null, "", link.hash);
      });
    });
  </script>
</BaseLayout>
