---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ContactBanner from "../components/ContactBanner.astro";
import RelatedContent from "../components/RelatedContent.astro";
import MailLink from "../components/MailLink.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config/siteConfig";
import { webPageSchema, organizationSchema } from "../utils/structuredData";
import { buildBreadcrumbList } from "../utils/seo";

const title = "後援会のご案内｜福富千恵と延岡を動かす会";
const description = "「福富千恵と延岡を動かす会」後援会のご案内です。福富千恵の活動を支え、延岡のこれからを市民の皆さまと一緒に考える政治団体の取り組みをご紹介します。";
const breadcrumbItems = [{ name: "後援会について", path: "/supporters" }];

/**
 * 応援の方法。実際の活動方針に沿うものだけを掲載する。
 * 新しい参加方法が決まった場合はここへ1件追加する（活動していないことは書かない）。
 */
const supportWays = [
  {
    icon: "megaphone" as const,
    title: "SNSで活動をシェアする",
    description:
      "Facebook・Instagram・Threadsの投稿をシェアしていただくだけでも、活動を知っていただく大きな力になります。",
  },
  {
    icon: "document-edit" as const,
    title: "市政への意見を寄せる",
    description:
      "延岡で感じている困りごとやご提案をお寄せください。整理したうえで、政策・提言に生かします。",
  },
  {
    icon: "users" as const,
    title: "意見交換会に参加する",
    description: "地域での意見交換会や活動の場に、お気軽にお越しください。聞くだけの参加も歓迎です。",
  },
  {
    icon: "house" as const,
    title: "看板・ポスターの設置に協力する",
    description:
      "看板やポスターを掲示できる場所をご提供いただける方は、事務局までご相談ください。",
  },
  {
    icon: "handshake" as const,
    title: "活動のお手伝いをする",
    description: "準備や当日の運営など、できる範囲でのお手伝いをお願いできる方を募集しています。",
  },
  {
    icon: "heart" as const,
    title: "後援会に入会する",
    description: "本会の理念・目的にご賛同いただける方は、後援会規約をご確認のうえご入会いただけます。",
  },
];

const schemas = [
  webPageSchema({ path: "/supporters", name: title, description }),
  organizationSchema(),
  buildBreadcrumbList(breadcrumbItems),
];
---

<BaseLayout title={title} description={description} path="/supporters" schemas={schemas}>
  <Breadcrumb items={breadcrumbItems} />
  <HeroSection title={siteConfig.organizationName} description="福富千恵の活動を支え、延岡のこれからを市民の皆さまと一緒に考える政治団体です。" />

  <section class="py-14 sm:py-20">
    <div class="section-wrap max-w-3xl space-y-10">
      <div>
        <h2 class="text-xl font-bold text-ink mb-3">団体について</h2>
        <p class="text-ink-soft leading-relaxed">
          {siteConfig.organizationName}は、地域の声を聞き、対話を重ね、支え合いと希望のある延岡を目指して活動する政治団体です。
        </p>
        <p class="mt-3 text-ink-soft leading-relaxed">
          福富千恵の経験を土台にした提言を発信するとともに、「みんなの声」を通じて市民の皆さまの意見を幅広く集め、活動へ反映させることを大切にしています。
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-ink mb-3">団体概要</h2>
        <dl class="card divide-y divide-black/5">
          <div class="py-3 grid grid-cols-3 gap-2">
            <dt class="text-ink-soft text-sm font-bold">団体名</dt>
            <dd class="col-span-2 text-ink">{siteConfig.organizationName}</dd>
          </div>
          <div class="py-3 grid grid-cols-3 gap-2">
            <dt class="text-ink-soft text-sm font-bold">所在地</dt>
            <dd class="col-span-2 text-ink">{siteConfig.postalCode}<br />{siteConfig.address}</dd>
          </div>
          <div class="py-3 grid grid-cols-3 gap-2">
            <dt class="text-ink-soft text-sm font-bold">メール</dt>
            <dd class="col-span-2 min-w-0 text-ink">
              <MailLink to="office" showIcon={false} showLabel={false} />
            </dd>
          </div>
        </dl>
      </div>

      {/*
        応援の方法。既存の活動方針（地域の声を聞き、対話を重ねる）に沿う範囲のみを掲載し、
        参加のハードルが高く見えないよう「できる範囲で」を明示する。
      */}
      <div>
        <h2 class="text-xl font-bold text-ink mb-3">応援の方法</h2>
        <p class="text-ink-soft leading-relaxed mb-5">
          応援のかたちに決まりはありません。<span class="font-bold text-ink">できる範囲での応援も歓迎です。</span>
          下記のうち、無理のないものからご参加いただけます。
        </p>
        <ul class="grid gap-4 sm:grid-cols-2">
          {supportWays.map((way) => (
            <li class="card flex min-w-0 items-start gap-3">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-brand-orange-light text-brand-orange-dark">
                <Icon name={way.icon} class="h-5 w-5" ariaHidden={true} />
              </span>
              <span class="min-w-0">
                <span class="block font-bold text-ink">{way.title}</span>
                <span class="mt-1 block text-sm text-ink-soft leading-relaxed">{way.description}</span>
              </span>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-sm text-ink-soft leading-relaxed">
          看板・ポスターの設置場所のご提供や、活動のお手伝いについては、事務局までお気軽にご相談ください。
          内容をうかがったうえで、無理のない範囲でご相談させていただきます。
        </p>
      </div>

      <div class="card text-center">
        <h2 class="text-xl font-bold text-ink mb-2">後援会への入会について</h2>
        <p class="text-ink-soft leading-relaxed mb-5">
          本会の理念・目的にご賛同いただける方は、後援会規約をご確認のうえ、後援会へご入会いただけます。
        </p>
        <a href="/supporters/join/" class="btn-primary">
          後援会に入会する
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-brand-ivory">
    <div class="section-wrap">
      {/*
        CTAの重複整理（11章）：
        「後援会に入会する」は上の入会カードで1回だけ案内しているため、ここでは繰り返さない。
        このバナーは、入会以外の相談（参加・協力・ご質問）の受け口として役割を分ける。
      */}
      <ContactBanner
        heading={"あなたと、延岡を動かす！"}
        description="活動への参加や、ご意見のお寄せをお待ちしています。できる範囲での応援も歓迎です。"
        primaryLabel="事務局へ問い合わせる"
        primaryHref="/contact/"
        secondaryLabel="ご意見を送る"
        secondaryHref="/voices/submit/"
      />
    </div>
  </section>

  <div class="section-wrap">
    <RelatedContent
      items={[
        { title: "福富千恵について", href: "/profile", description: "福富千恵のプロフィールと歩みをご紹介します。" },
        { title: "政策・提言", href: "/vision", description: "現状・課題・提言と、その調査状況をご覧いただけます。" },
        { title: "活動報告", href: "/activities", description: "延岡での地域活動の様子をお伝えします。" },
      ]}
    />
  </div>
</BaseLayout>
