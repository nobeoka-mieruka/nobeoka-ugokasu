---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VoiceHero from "../../components/VoiceHero.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import Icon from "../../components/Icon.astro";
import VoiceEngagementFlow from "../../components/VoiceEngagementFlow.astro";
import VoiceSummaryPanel from "../../components/VoiceSummaryPanel.astro";
import VoiceStatusPipeline from "../../components/VoiceStatusPipeline.astro";
import { voicesConfig } from "../../config/voicesConfig";
import { voiceThemes } from "../../data/voiceThemes";
import { webPageSchema } from "../../utils/structuredData";
import { buildBreadcrumbList } from "../../utils/seo";

const title = "みんなの声｜福富千恵と延岡を動かす会";
const description = "福富千恵と延岡を動かす会の「みんなの声（ブロードリスニング）」のご紹介です。市民の皆さまの声を集め、整理し、対応状況を公開しています。";
const breadcrumbItems = [{ name: "みんなの声", path: "/voices" }];

const schemas = [
  webPageSchema({ path: "/voices", name: title, description }),
  buildBreadcrumbList(breadcrumbItems),
];
---

<BaseLayout title={title} description={description} path="/voices" schemas={schemas}>
  <Breadcrumb items={breadcrumbItems} />
  <VoiceHero
    title={"あなたの声から、\n延岡のこれからを考えます。"}
    description="多様な声を幅広く集め、共通する課題、異なる立場からの意見、少数でも重要な意見を整理し、今後の活動や提言に生かす取り組みです。単なる多数決や人気投票ではありません。"
  />

  {/*
    「意見を送る」を、このページで最も分かりやすい主要な行動として最初に置く。
    Googleフォームは /voices/submit/ ページ側から開く既存の導線をそのまま使う。
  */}
  <section class="pt-12 sm:pt-16">
    <div class="section-wrap max-w-4xl">
      <div class="card border-l-4 border-brand-orange text-center">
        <h2 class="text-2xl font-bold text-ink">延岡で感じていることを、お聞かせください</h2>
        <p class="mt-3 text-ink-soft leading-relaxed">
          小さな困りごとでも、制度について感じていることでも構いません。
          いただいたご意見は、個人情報を取り除いたうえで整理し、今後の活動や提言に生かします。
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
          <a href="/voices/submit/" class="btn-primary">延岡についてのご意見を送る</a>
          <a href="/voices/themes/" class="btn-secondary">募集中のテーマを見る</a>
        </div>
        {/*
          「ご意見」と「お問い合わせ」は宛先も扱いも異なるため、違いを明示する。
          ・ご意見     → Googleフォーム。匿名で送れ、整理・分析のうえ提言へ反映します
          ・お問い合わせ → 事務局メール。個別のご質問・ご連絡に事務局がお返事します
        */}
        <div class="mt-6 border-t border-black/10 pt-5 text-left">
          <p class="text-sm text-ink-soft leading-relaxed">
            <span class="font-bold text-ink">ご意見を送る</span>（上のボタン）は、延岡の課題やお困りごとを
            <span class="font-bold text-ink">フォーム</span>でお寄せいただくものです。
            お名前の入力は必須ではなく、個人情報を取り除いたうえで整理し、政策・提言に生かします。
          </p>
          <p class="mt-3 text-sm text-ink-soft leading-relaxed">
            <span class="font-bold text-ink">個別のご質問・ご連絡</span>（掲載内容、後援会、取材のご依頼など）は、
            事務局あてのメールで承っています。
          </p>
          <div class="mt-4">
            <a href="/contact/" class="btn-secondary">事務局へ問い合わせる</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="section-wrap max-w-4xl">
      <h2 class="sr-only">みんなの声のご案内</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        <a href="/voices/submit/" class="card hover:shadow-md transition-shadow flex flex-col gap-2">
          <Icon name="megaphone" class="w-8 h-8 text-brand-orange" />
          <h3 class="font-bold text-ink text-lg">声を届ける</h3>
          <p class="text-sm text-ink-soft">ご意見やお困りごとをお寄せください。</p>
        </a>
        <a href="/voices/themes/" class="card hover:shadow-md transition-shadow flex flex-col gap-2">
          <Icon name="document" class="w-8 h-8 text-brand-orange" />
          <h3 class="font-bold text-ink text-lg">意見募集中のテーマ</h3>
          <p class="text-sm text-ink-soft">現在募集しているテーマの一覧です。</p>
        </a>
        <a href="/voices/reports/" class="card hover:shadow-md transition-shadow flex flex-col gap-2">
          <Icon name="users" class="w-8 h-8 text-brand-orange" />
          <h3 class="font-bold text-ink text-lg">分析結果一覧</h3>
          <p class="text-sm text-ink-soft">集まった声の分析結果を公開しています。</p>
        </a>
        <a href="/voices/method/" class="card hover:shadow-md transition-shadow flex flex-col gap-2">
          <Icon name="handshake" class="w-8 h-8 text-brand-orange" />
          <h3 class="font-bold text-ink text-lg">声の集め方・整理方法</h3>
          <p class="text-sm text-ink-soft">どのように集め、整理しているかをご説明します。</p>
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-brand-ivory">
    <div class="section-wrap max-w-4xl">
      <SectionTitle title="受付から反映までの流れ" align="left" />
      <VoiceEngagementFlow />
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="section-wrap max-w-4xl">
      <SectionTitle title="声が政策につながるまで" align="left" />
      <p class="text-ink-soft leading-relaxed mb-6">
        お預かりしたご意見は、次の5つの段階を経て、政策・提言へ反映していきます。
        各段階の件数は、集計がまとまった項目から順に公開します。
      </p>
      <VoiceStatusPipeline />
      <div class="mt-8">
        <VoiceSummaryPanel />
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/voices/submit/" class="btn-primary">延岡についてのご意見を送る</a>
        <a href="/vision/" class="btn-secondary">政策・提言を見る</a>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-brand-ivory">
    <div class="section-wrap max-w-4xl">
      <SectionTitle title="現在寄せられている主なテーマ" align="left" />
      <p class="text-ink-soft leading-relaxed mb-6">
        以下のテーマで意見を募集しています。テーマごとの件数は、集計がまとまり次第それぞれのテーマページで公開します。
      </p>
      <ul class="flex flex-wrap gap-2">
        {voiceThemes.map((theme) => (
          <li>
            <a
              href={`/voices/themes/${theme.slug}/`}
              class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-white ring-1 ring-black/10 px-4 py-2 text-sm font-bold text-ink hover:ring-brand-orange-dark hover:bg-brand-orange-light transition-colors"
            >
              {theme.title}
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-6">
        <a href="/voices/themes/" class="btn-secondary">募集中のテーマを見る</a>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="section-wrap max-w-4xl">
      <SectionTitle title="対応状況について" align="left" />
      <p class="text-ink-soft leading-relaxed mb-4">
        寄せられたご意見への対応状況は、以下のいずれかの状態で管理・公開しています。
      </p>
      <ul class="grid gap-2 sm:grid-cols-3">
        {voicesConfig.responseStatusLabels.map((label) => (
          <li class="card py-3 text-center text-sm font-bold text-ink">{label}</li>
        ))}
      </ul>
      <p class="mt-4 text-sm text-ink-soft">
        「現時点では対応が困難です」とする場合は、可能な範囲で理由もあわせて公開します。
      </p>
      <div class="mt-8">
        <a href="/voices/method/" class="btn-secondary">声の集め方・整理方法を見る</a>
      </div>
    </div>
  </section>

  <div class="section-wrap">
    <RelatedContent
      items={[
        { title: "私たちの提言", href: "/vision", description: "寄せられた声は今後の提言の参考にします。" },
        { title: "福富千恵について", href: "/profile", description: "福富千恵の経験と提言の背景をご紹介します。" },
        { title: "延岡市役所 どこに行けばいい？診断", href: "/city-guide", description: "行政手続きに関するお困りごとは、こちらの窓口案内もご活用ください。" },
      ]}
    />
  </div>
</BaseLayout>
