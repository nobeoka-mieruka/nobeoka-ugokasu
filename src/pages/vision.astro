---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import LastUpdated from "../components/LastUpdated.astro";
import RelatedContent from "../components/RelatedContent.astro";
import VisionStatusBadge from "../components/VisionStatusBadge.astro";
import VisionStatusSteps from "../components/VisionStatusSteps.astro";
import VisionEvidenceCard from "../components/VisionEvidenceCard.astro";
import InlineRelatedLinks from "../components/InlineRelatedLinks.astro";
import Icon from "../components/Icon.astro";
import { visionHeading, visionSubtitle, visionProposals, type VisionProposal } from "../data/vision";
import { profileChapters } from "../data/profile";
import { getSortedSnsActivities } from "../data/snsActivities";
import { getVoiceTheme } from "../data/voiceThemes";
import { webPageSchema } from "../utils/structuredData";
import { buildBreadcrumbList } from "../utils/seo";
import { buildRelatedActivities } from "../utils/relatedActivities";
import socialPostsSnapshot from "../data/socialPostsSnapshot.json";
import type { BuildSocialPost } from "../types/social";

const title = "福富千恵の政策・提言｜延岡市の未来を考える";
const description =
  "福富千恵が取り組む政策や提言をご紹介します。福祉、子育て、高齢者支援、行政サービス改善などについて発信しています。";

const breadcrumbItems = [{ name: "私たちの提言", path: "/vision" }];

const activities = await getCollection("activities", ({ data }) => data.published);

// scripts/sync-facebook-posts.mjs がビルド時に生成する、Facebook投稿のスナップショット。
// 実際の活動報告は主にこのSNS投稿から構成されているため、提言との関連付けにも使う
//（Meta APIへ直接アクセスすることはしない）。
const buildSocialPosts = socialPostsSnapshot.posts as unknown as BuildSocialPost[];
const snsActivities = getSortedSnsActivities();

const accentClassMap = {
  welfare: { text: "text-accent-welfare", border: "border-accent-welfare" },
  childcare: { text: "text-accent-childcare", border: "border-accent-childcare" },
  disaster: { text: "text-accent-disaster", border: "border-accent-disaster" },
};

/**
 * 提言の背景となるプロフィール章を取得する。
 * 型ガード付きのfilterはテンプレート内の{}式に直接書くとAstroのTSXパーサーで
 * 構文エラーになるため、frontmatter側の関数として切り出している。
 */
function getRelatedProfileChapters(proposal: VisionProposal) {
  return proposal.relatedProfileChapterIds
    .map((chapterId) => profileChapters.find((chapter) => chapter.id === chapterId))
    .filter((chapter): chapter is NonNullable<typeof chapter> => Boolean(chapter));
}

const schemas = [
  webPageSchema({ path: "/vision", name: title, description }),
  buildBreadcrumbList(breadcrumbItems),
];
---

<BaseLayout title={title} description={description} path="/vision" schemas={schemas}>
  <Breadcrumb items={breadcrumbItems} />
  <HeroSection title={visionHeading} description={visionSubtitle} eyebrow="私たちの提言" />

  <section class="py-14 sm:py-20">
    <div class="section-wrap max-w-4xl space-y-16">
      {visionProposals.map((proposal) => {
        const accent = accentClassMap[proposal.accentColor];
        const relatedActivities = buildRelatedActivities(proposal, { activities, buildSocialPosts, snsActivities });
        const voiceTheme = getVoiceTheme(proposal.relatedVoiceThemeSlug);
        const relatedChapters = getRelatedProfileChapters(proposal);
        return (
          <article id={proposal.slug} class:list={["border-l-4 pl-6 scroll-mt-24", accent.border]}>
            <VisionStatusBadge status={proposal.status} />
            <h2 class="mt-3 text-2xl sm:text-3xl font-bold text-ink whitespace-pre-line">{proposal.title}</h2>

            <div class="mt-6">
              <VisionStatusSteps status={proposal.status} />
            </div>

            <div class="mt-6">
              <h3 class="text-lg font-bold text-ink">現状と課題</h3>
              <ul class="mt-2 space-y-1">
                {proposal.currentIssues.map((issue) => (
                  <li class="flex items-start gap-2 text-ink-soft leading-relaxed">
                    <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-ink-soft"></span>
                    <span>{issue}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-6">
              <h3 class="text-lg font-bold text-ink">なぜ取り組むのか</h3>
              <div class="mt-2 space-y-2 text-ink-soft leading-relaxed">
                {proposal.background.map((p) => <p>{p}</p>)}
              </div>
            </div>

            <div class="mt-6">
              <h3 class="text-lg font-bold text-ink">対象となる市民</h3>
              <p class="mt-2 text-ink-soft leading-relaxed">{proposal.targetAudience}</p>
            </div>

            <div class="mt-6">
              <h3 class="text-lg font-bold text-ink">具体的な取り組み</h3>
              <ul class="mt-2 space-y-2">
                {proposal.proposals.map((item) => (
                  <li class="flex items-start gap-2 font-bold text-ink">
                    <Icon name="check" class:list={["w-5 h-5 flex-shrink-0 mt-0.5", accent.text]} />
                    <span class="min-w-0 whitespace-pre-line">{item}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-3 text-ink-soft leading-relaxed">{proposal.administrativeAsk}</p>
            </div>

            <div class="mt-6">
              <h3 class="text-lg font-bold text-ink">実現へのステップ</h3>
              <ul class="mt-2 space-y-2">
                <li class="flex items-start gap-2 text-ink-soft leading-relaxed">
                  <span class="mt-0.5 flex-shrink-0 rounded-full bg-brand-orange-light px-2 py-0.5 text-xs font-bold text-ink">短期</span>
                  <span>{proposal.implementationSteps.shortTerm}</span>
                </li>
                <li class="flex items-start gap-2 text-ink-soft leading-relaxed">
                  <span class="mt-0.5 flex-shrink-0 rounded-full bg-brand-orange-light px-2 py-0.5 text-xs font-bold text-ink">中期</span>
                  <span>{proposal.implementationSteps.midTerm}</span>
                </li>
                <li class="flex items-start gap-2 text-ink-soft leading-relaxed">
                  <span class="mt-0.5 flex-shrink-0 rounded-full bg-brand-orange-light px-2 py-0.5 text-xs font-bold text-ink">長期</span>
                  <span>{proposal.implementationSteps.longTerm}</span>
                </li>
              </ul>
            </div>

            <div class="mt-6">
              <h3 class="text-lg font-bold text-ink">目指す変化</h3>
              <p class="mt-2 text-ink-soft leading-relaxed">{proposal.targetChange}</p>
            </div>

            <div class="mt-6">
              <h3 class="text-lg font-bold text-ink">市民の声との関係</h3>
              <p class="mt-2 text-ink-soft leading-relaxed">{proposal.citizenVoices}</p>
            </div>

            <div class="mt-6">
              <h3 class="text-lg font-bold text-ink">現在の検討状況</h3>
              <p class="mt-2 text-ink-soft leading-relaxed">{proposal.reviewStatus}</p>
            </div>

            <VisionEvidenceCard evidenceItems={proposal.evidenceItems} relatedPlans={proposal.relatedPlans} />

            {relatedChapters.length > 0 && (
              <InlineRelatedLinks
                heading="この提言につながる福富千恵の経験"
                items={relatedChapters.map((c) => ({ title: c.title, href: `/profile/#${c.id}` }))}
              />
            )}

            <div class="mt-6" data-vision-related={proposal.slug}>
              <h3 class="text-lg font-bold text-ink">関連する活動報告</h3>
              <ul class:list={["mt-2 space-y-1", relatedActivities.length === 0 && "hidden"]} data-vision-related-list>
                {relatedActivities.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-ink font-bold hover:underline"
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                    >
                      {item.title}
                    </a>
                    {item.external && <span class="sr-only">（新しいタブで開く・外部サイト）</span>}
                  </li>
                ))}
              </ul>
              <p class:list={["mt-2 text-ink-soft", relatedActivities.length > 0 && "hidden"]} data-vision-related-empty>
                このテーマに関する活動報告は、今後掲載予定です。
              </p>
            </div>

            {voiceTheme && (
              <div class="mt-6 rounded-xl bg-brand-orange-light/40 ring-1 ring-black/5 p-5">
                <p class="text-ink-soft leading-relaxed">
                  延岡で感じている「{voiceTheme.title}」に関する困りごとやご意見をお聞かせください。
                </p>
                <a
                  href={`/voices/themes/${voiceTheme.slug}/`}
                  class="btn-secondary mt-4 inline-flex"
                >
                  このテーマについて意見を送る
                  <Icon name="arrow-right" class="w-4 h-4" ariaHidden={true} />
                </a>
              </div>
            )}

            {proposal.officialLinks.length > 0 && (
              <div class="mt-6">
                <h3 class="text-lg font-bold text-ink">関連資料（公的資料・延岡市公式ページ）</h3>
                <ul class="mt-2 space-y-1">
                  {proposal.officialLinks.map((link) => (
                    <li>
                      <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-ink font-bold hover:underline">
                        {link.label}
                        <span class="sr-only">（新しいタブで開く・外部サイト）</span>
                        <Icon name="external-link" class="w-4 h-4" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="mt-6">
              <LastUpdated date={proposal.lastUpdated || undefined} />
            </div>

            <div class="mt-4">
              <a href={`/issues/${proposal.slug}/`} class="inline-flex items-center gap-1 font-bold text-ink hover:underline">
                {proposal.shortTitle}の詳細ページへ
                <Icon name="arrow-right" class:list={["w-4 h-4", accent.text]} />
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <div class="section-wrap">
    <RelatedContent
      items={[
        { title: "福富千恵について", href: "/profile", description: "提言の背景となる福富千恵自身の歩みをご紹介します。" },
        { title: "みんなの声", href: "/voices", description: "提言に関するご意見をお寄せください。" },
        { title: "分析結果一覧", href: "/voices/reports", description: "寄せられた声の分析結果を公開しています。" },
      ]}
    />
  </div>
</BaseLayout>

<script>
  // ビルド時点のスナップショットに無い最新のFacebook投稿を/api/social-feedから取得し、
  // 各提言のキーワードに一致するものだけを「関連する活動報告」へ追加する
  // （Facebook投稿の取得・表示そのものの仕組みは変更せず、既存のfetchSocialPostsを読むだけ）。
  import { fetchSocialPosts } from "../services/socialPosts";
  import { visionProposals } from "../data/vision";
  import { textMatchesKeywords } from "../utils/visionRelated";

  const MAX_RELATED_ACTIVITIES = 3;

  (async () => {
    const { posts } = await fetchSocialPosts();
    if (posts.length === 0) return;

    for (const proposal of visionProposals) {
      const container = document.querySelector<HTMLElement>(`[data-vision-related="${proposal.slug}"]`);
      const list = container?.querySelector<HTMLUListElement>("[data-vision-related-list]");
      const empty = container?.querySelector<HTMLElement>("[data-vision-related-empty]");
      if (!list) continue;

      const remaining = Math.max(0, MAX_RELATED_ACTIVITIES - list.children.length);
      if (remaining === 0) continue;

      const known = new Set<string>();
      list.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((a) => known.add(a.href));

      const matches = posts
        .filter((post) => textMatchesKeywords(`${post.title} ${post.description}`, proposal.relatedKeywords))
        .filter((post) => !known.has(post.permalink))
        .slice(0, remaining);

      if (matches.length === 0) continue;

      for (const post of matches) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = post.permalink;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.className = "text-ink font-bold hover:underline";
        a.textContent = post.title;
        li.append(a);
        const sr = document.createElement("span");
        sr.className = "sr-only";
        sr.textContent = "（新しいタブで開く・外部サイト）";
        li.append(sr);
        list.append(li);
      }

      list.classList.remove("hidden");
      empty?.classList.add("hidden");
    }
  })();
</script>
