---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedContent from "../components/RelatedContent.astro";
import VisionProposalArticle from "../components/VisionProposalArticle.astro";
import { visionHeading, visionSubtitle, visionProposals, type VisionProposal } from "../data/vision";
import { profileChapters } from "../data/profile";
import { getSortedSnsActivities } from "../data/snsActivities";
import { getSortedActivityEntries } from "../data/activityEntries";
import { getVoiceTheme } from "../data/voiceThemes";
import { webPageSchema } from "../utils/structuredData";
import { buildBreadcrumbList } from "../utils/seo";
import { buildRelatedActivities } from "../utils/relatedActivities";
import { warnIfMissingSlug } from "../utils/devWarn";
import socialPostsSnapshot from "../data/socialPostsSnapshot.json";
import type { BuildSocialPost } from "../types/social";

const title = "政策・提言｜福富千恵と延岡を動かす会";
const description =
  "福富千恵と延岡を動かす会の政策・提言です。福祉・介護、子育て、防災について、延岡市の公式資料で確認できたデータと出典を示しながら、現状・課題・提言と調査状況を公開しています。";

const breadcrumbItems = [{ name: "私たちの提言", path: "/vision" }];

const activities = await getCollection("activities", ({ data }) => data.published);

// scripts/sync-social-posts.mjs がビルド時に生成する、SNS投稿のスナップショット。
// 提言との関連付けにも使う（Meta APIへ直接アクセスすることはしない）。
const buildSocialPosts = socialPostsSnapshot.posts as unknown as BuildSocialPost[];
const snsActivities = getSortedSnsActivities();
// サイト側で管理する活動報告。SNSが取得できない場合でも関連付けが空にならないようにする。
const activityEntries = getSortedActivityEntries();

/**
 * 提言の背景となるプロフィール章を取得する。
 * 型ガード付きのfilterはテンプレート内の{}式に直接書くとAstroのTSXパーサーで
 * 構文エラーになるため、frontmatter側の関数として切り出している。
 */
function getRelatedProfileChapters(proposal: VisionProposal) {
  return proposal.relatedProfileChapterIds
    .map((chapterId) => profileChapters.find((chapter) => chapter.id === chapterId))
    .filter((chapter): chapter is NonNullable<typeof chapter> => Boolean(chapter));
}

// 設定ミスで存在しないslugを参照していないかをビルド時に確認する（console.warnのみ、ビルドは失敗させない）
for (const proposal of visionProposals) {
  warnIfMissingSlug(
    Boolean(getVoiceTheme(proposal.relatedVoiceThemeSlug)),
    `vision.ts の "${proposal.slug}" 提言の relatedVoiceThemeSlug`,
    proposal.relatedVoiceThemeSlug,
  );
  for (const chapterId of proposal.relatedProfileChapterIds) {
    warnIfMissingSlug(
      profileChapters.some((chapter) => chapter.id === chapterId),
      `vision.ts の "${proposal.slug}" 提言の relatedProfileChapterIds`,
      chapterId,
    );
  }
}

const schemas = [
  webPageSchema({ path: "/vision", name: title, description }),
  buildBreadcrumbList(breadcrumbItems),
];
---

<BaseLayout title={title} description={description} path="/vision" schemas={schemas}>
  <Breadcrumb items={breadcrumbItems} />
  <HeroSection title={visionHeading} description={visionSubtitle} eyebrow="私たちの提言" />

  <section class="py-14 sm:py-20">
    <div class="section-wrap max-w-4xl space-y-16">
      {visionProposals.map((proposal) => {
        const relatedActivities = buildRelatedActivities(proposal, {
          activities,
          buildSocialPosts,
          snsActivities,
          activityEntries,
        });
        return (
          <VisionProposalArticle
            proposal={proposal}
            relatedActivities={relatedActivities}
            relatedChapters={getRelatedProfileChapters(proposal)}
            voiceTheme={getVoiceTheme(proposal.relatedVoiceThemeSlug)}
          />
        );
      })}
    </div>
  </section>

  <div class="section-wrap">
    <RelatedContent
      items={[
        { title: "福富千恵について", href: "/profile", description: "提言の背景となる福富千恵自身の歩みをご紹介します。" },
        { title: "みんなの声", href: "/voices", description: "提言に関するご意見をお寄せください。" },
        { title: "分析結果一覧", href: "/voices/reports", description: "寄せられた声の分析結果を公開しています。" },
      ]}
    />
  </div>
</BaseLayout>

<script>
  // ビルド時点のスナップショットに無い最新のFacebook投稿を/api/social-feedから取得し、
  // 各提言のキーワードに一致するものだけを「関連する活動報告」へ追加する
  // （Facebook投稿の取得・表示そのものの仕組みは変更せず、既存のfetchSocialPostsを読むだけ）。
  import { fetchSocialPosts } from "../services/socialPosts";
  import { visionProposals } from "../data/vision";
  import { textMatchesKeywords } from "../utils/visionRelated";

  const MAX_RELATED_ACTIVITIES = 3;

  (async () => {
    const { posts } = await fetchSocialPosts();
    if (posts.length === 0) return;

    for (const proposal of visionProposals) {
      const container = document.querySelector<HTMLElement>(`[data-vision-related="${proposal.slug}"]`);
      const list = container?.querySelector<HTMLUListElement>("[data-vision-related-list]");
      const empty = container?.querySelector<HTMLElement>("[data-vision-related-empty]");
      if (!list) continue;

      const remaining = Math.max(0, MAX_RELATED_ACTIVITIES - list.children.length);
      if (remaining === 0) continue;

      const known = new Set<string>();
      list.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((a) => known.add(a.href));

      const matches = posts
        .filter((post) => textMatchesKeywords(`${post.title} ${post.description}`, proposal.relatedKeywords))
        .filter((post) => !known.has(post.permalink))
        .slice(0, remaining);

      if (matches.length === 0) continue;

      for (const post of matches) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = post.permalink;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.className = "text-ink font-bold hover:underline";
        a.textContent = post.title;
        li.append(a);
        const sr = document.createElement("span");
        sr.className = "sr-only";
        sr.textContent = "（新しいタブで開く・外部サイト）";
        li.append(sr);
        list.append(li);
      }

      list.classList.remove("hidden");
      empty?.classList.add("hidden");
    }
  })();
</script>
